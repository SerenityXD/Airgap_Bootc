    hdf5 hdf5-devel openblas-devel \
    lapack lapack-devel \
    # Triton Inference Server client dependencies
    python3-protobuf python3-grpcio python3-requests \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Install Node.js tools, graphics/database apps, filesystem, and boot packages
RUN dnf -y --setopt=install_weak_deps=False install \
    nodejs npm yarn \
    sqlite sqlite-devel sqlitebrowser \
    ntfs-3g ntfsprogs exfatprogs \
    e2fsprogs btrfs-progs xfsprogs f2fs-tools dosfstools \
    grub2-pc grub2-pc-modules \
    grub2-efi-x64 grub2-efi-x64-modules grub2-efi-x64-cdboot \
    grub2-efi-ia32 grub2-efi-ia32-cdboot \
    grub2-tools grub2-tools-efi \
    syslinux efibootmgr \
    shim-x64 shim-ia32 \
    dracut dracut-live \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Optionally install Blender 4.2 LTS (official portable tarball, offline preferred)
# Blender 4.2.x was never packaged for Fedora 43, so we use the official blender.org
# portable Linux release extracted to /opt/blender-4.2.
COPY offline-repo/blender/ /tmp/blender/
RUN if [ "$EXCLUDE_BLENDER" != "yes" ]; then \
        install_blender_bundle() { \
            local tarball_path="$1"; \
            mkdir -p /opt/blender-4.2; \
            tar -xJf "$tarball_path" -C /opt/blender-4.2 --strip-components=1; \
            ln -sf /opt/blender-4.2/blender /usr/local/bin/blender; \
            if [ -f /opt/blender-4.2/blender.desktop ]; then \
                install -Dm0644 /opt/blender-4.2/blender.desktop /usr/share/applications/blender.desktop; \
            fi; \
            if [ -f /opt/blender-4.2/blender.svg ]; then \
                install -Dm0644 /opt/blender-4.2/blender.svg /usr/share/icons/hicolor/scalable/apps/blender.svg; \
            fi; \
            if [ -f /opt/blender-4.2/blender-symbolic.svg ]; then \
                install -Dm0644 /opt/blender-4.2/blender-symbolic.svg /usr/share/icons/hicolor/symbolic/apps/blender-symbolic.svg; \
            fi; \
        }; \
        TARBALL=$(ls /tmp/blender/blender-4.2*.tar.xz 2>/dev/null | head -1); \
        if [ -n "$TARBALL" ]; then \
            echo "Installing Blender 4.2 from offline tarball: ${TARBALL}..."; \
            install_blender_bundle "$TARBALL"; \
            echo "Blender installed to /opt/blender-4.2 with desktop launcher"; \
        else \
            echo "Offline Blender 4.2 tarball not found; downloading from blender.org..."; \
            BLENDER_VER="4.2.9"; \
            curl -fL "https://download.blender.org/release/Blender4.2/blender-${BLENDER_VER}-linux-x64.tar.xz" \
                -o /tmp/blender.tar.xz || { echo "Warning: Blender download failed"; true; }; \
            if [ -f /tmp/blender.tar.xz ]; then \
                install_blender_bundle /tmp/blender.tar.xz; \
                rm -f /tmp/blender.tar.xz; \
            fi; \
        fi; \
    else \
        echo "Blender skipped (set --build-arg EXCLUDE_BLENDER=yes to exclude)"; \
    fi

# Install OBS Studio and multimedia codecs (offline preferred, online fallback)
RUN --mount=type=bind,source=offline-repo/obs,target=/tmp/offline/obs,readonly \
    --mount=type=bind,source=offline-repo/rpmfusion,target=/tmp/offline/rpmfusion,readonly \
    install_from_local_rpm_repo() { \
        local repo_id="$1"; \
        local repo_dir="$2"; \
        shift 2; \
        local temp_repo_dir install_rc; \
        local -A seen_packages=(); \
        local -a package_names=(); \
        local pattern rpm_path package_name; \
        for pattern in "$@"; do \
            rpm_path=$(find "$repo_dir" -maxdepth 1 -type f -name "$pattern" | sort -V | tail -n 1); \
            if [ -z "$rpm_path" ]; then \
                continue; \
            fi; \
            package_name=$(rpm -qp --qf '%{NAME}\n' "$rpm_path" 2>/dev/null || true); \
            if [ -n "$package_name" ] && [ -z "${seen_packages[$package_name]:-}" ]; then \
                seen_packages[$package_name]=1; \
                package_names+=("$package_name"); \
            fi; \
        done; \
        if [ ${#package_names[@]} -eq 0 ]; then \
            echo "No curated packages found in $repo_dir"; \
            return 1; \
        fi; \
        echo "Preparing local RPM repo $repo_id from $repo_dir"; \
        temp_repo_dir=$(mktemp -d "/tmp/${repo_id}.XXXXXX"); \
        cp -a "$repo_dir"/. "$temp_repo_dir"/; \
        dnf -y --setopt=install_weak_deps=False install createrepo_c && \
        createrepo_c "$temp_repo_dir" >/dev/null && \
        echo "Installing curated packages from $repo_id: ${package_names[*]}" && \
        dnf -y --setopt=install_weak_deps=False \
            --repofrompath="$repo_id,file://$temp_repo_dir" \
            --setopt="$repo_id.gpgcheck=0" \
            --setopt="$repo_id.localpkg_gpgcheck=0" \
            --enablerepo="$repo_id" \
            install --best --skip-broken "${package_names[@]}"; \
        install_rc=$?; \
        rm -rf "$temp_repo_dir"; \
        return $install_rc; \
    }; \
    offline_installed=0; \
    if compgen -G "/tmp/offline/obs/*.rpm" >/dev/null; then \
        echo "Attempting curated OBS install from offline repo..."; \
        if install_from_local_rpm_repo obs-local /tmp/offline/obs \
            'ffmpeg-[0-9]*.x86_64.rpm' \
            'ffmpeg-libs-[0-9]*.x86_64.rpm' \
            'lame-libs-[0-9]*.x86_64.rpm' \
            'libheif-freeworld-[0-9]*.x86_64.rpm' \
            'obs-studio-[0-9]*.x86_64.rpm' \
            'obs-studio-libs-[0-9]*.x86_64.rpm' \
            'obs-studio-plugin-*.x86_64.rpm' \
            'vlc-libs-[0-9]*.x86_64.rpm' \
            'x264-libs-[0-9]*.x86_64.rpm' \
            'x265-libs-[0-9]*.x86_64.rpm' \
            'lame-[0-9]*.x86_64.rpm' \
            'gstreamer1-plugins-bad-free-extras-[0-9]*.x86_64.rpm' \
            'gstreamer1-plugins-ugly-[0-9]*.x86_64.rpm' \
            'gstreamer1-libav-[0-9]*.x86_64.rpm' \
            'libavcodec-freeworld-[0-9]*.x86_64.rpm' \
            'libavformat-freeworld-[0-9]*.x86_64.rpm' \
            'libavutil-freeworld-[0-9]*.x86_64.rpm' \
            'libswscale-freeworld-[0-9]*.x86_64.rpm' \
            'libswresample-freeworld-[0-9]*.x86_64.rpm'; then \
            offline_installed=1; \
            echo "OBS Studio installed successfully from curated offline packages"; \
        else \
            echo "Warning: curated OBS offline install failed, falling back to online repos"; \
        fi; \
    elif compgen -G "/tmp/offline/rpmfusion/*.rpm" >/dev/null; then \
        echo "Attempting curated RPM Fusion install from offline repo..."; \
        if install_from_local_rpm_repo rpmfusion-local /tmp/offline/rpmfusion \
            'ffmpeg-[0-9]*.x86_64.rpm' \
            'ffmpeg-libs-[0-9]*.x86_64.rpm' \
            'mpv-[0-9]*.x86_64.rpm' \
            'vlc-[0-9]*.x86_64.rpm' \
            'x264-*.x86_64.rpm' \
            'x265-*.x86_64.rpm' \
            'lame-[0-9]*.x86_64.rpm' \
            'gstreamer1-plugins-bad-free-extras-[0-9]*.x86_64.rpm' \
            'gstreamer1-plugins-ugly-[0-9]*.x86_64.rpm' \
            'gstreamer1-libav-[0-9]*.x86_64.rpm' \
            'libavcodec-freeworld-[0-9]*.x86_64.rpm' \
            'libavformat-freeworld-[0-9]*.x86_64.rpm' \
            'libavutil-freeworld-[0-9]*.x86_64.rpm' \
            'libswscale-freeworld-[0-9]*.x86_64.rpm' \
            'libswresample-freeworld-[0-9]*.x86_64.rpm'; then \
            offline_installed=1; \
            echo "RPM Fusion multimedia packages installed from curated offline packages"; \
        else \
            echo "Warning: curated RPM Fusion offline install failed, falling back to online repos"; \
        fi; \
    fi; \
    if [ "$offline_installed" -ne 1 ]; then \
        echo "Offline OBS/RPM Fusion packages not usable, attempting online install..."; \
        dnf -y --setopt=install_weak_deps=False install \
            https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
            https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm || true; \
        dnf -y --setopt=install_weak_deps=False swap --allowerasing ffmpeg-free ffmpeg || true; \
        dnf -y --setopt=install_weak_deps=False install --best --skip-broken ffmpeg vlc obs-studio \
            gstreamer1-plugins-bad-free-extras gstreamer1-plugins-ugly \
            gstreamer1-plugin-openh264 gstreamer1-libav lame x264 x265 \
            --allowerasing || true; \
    fi && \
    dnf -y clean all && rm -rf /var/cache/dnf && \
    dnf -y remove createrepo_c >/dev/null 2>&1 || true && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Install NVIDIA drivers from RPM Fusion
# First install RPM Fusion repository (if not already installed) and akmods infrastructure
RUN (dnf -y --setopt=install_weak_deps=False install \
        https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm || \
    echo "RPM Fusion nonfree repository already installed or installation failed") && \
    dnf -y --setopt=install_weak_deps=False install \
        akmods \
        kernel-headers && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Install NVIDIA driver packages
RUN dnf -y --setopt=install_weak_deps=False install --best \
        akmod-nvidia \
        xorg-x11-drv-nvidia \
    xorg-x11-drv-nvidia-power \
        xorg-x11-drv-nvidia-cuda \
        xorg-x11-drv-nvidia-cuda-libs \
        nvidia-settings \
        nvidia-persistenced && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Build NVIDIA kernel modules at container build time for bootc read-only filesystem
# This prevents runtime akmods failures on immutable /usr
RUN if [ -f /usr/sbin/akmods ]; then \
        echo "Building NVIDIA kernel modules for installed kernel(s)..."; \
        KERNEL_VERSIONS=$(rpm -q kernel --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' 2>/dev/null); \
        if [ -n "$KERNEL_VERSIONS" ]; then \
            echo "Found kernel version(s):"; \
            echo "$KERNEL_VERSIONS"; \
            echo "Verifying build dependencies..."; \
            rpm -q gcc make kernel-devel kernel-headers akmods || echo "Warning: some build dependencies missing"; \
            if akmods --force; then \
                echo "NVIDIA kernel modules built successfully for all kernels"; \
                echo "Verifying nvidia.ko module presence..."; \
                for kver in $KERNEL_VERSIONS; do \
                    if [ -f "/usr/lib/modules/$kver/extra/nvidia/nvidia.ko" ] || \
                       [ -f "/usr/lib/modules/$kver/extra/nvidia/nvidia.ko.xz" ]; then \
                        echo "✓ nvidia.ko found for kernel $kver"; \
                    else \
                        echo "✗ Warning: nvidia.ko NOT found for kernel $kver"; \
                        find /usr/lib/modules/$kver -name "nvidia*.ko*" 2>/dev/null || echo "  No NVIDIA modules found"; \
                    fi; \
                done; \
                echo "Writing nouveau blacklist and NVIDIA power-management config..."; \
                mkdir -p /etc/modprobe.d; \
                printf '%s\n' \
                    '# Blacklist nouveau to prevent conflicts with NVIDIA proprietary driver' \
                    'blacklist nouveau' \
                    'options nouveau modeset=0' \
                    > /etc/modprobe.d/blacklist-nouveau.conf; \
                printf '%s\n' \
                    '# NVIDIA power management for Wayland suspend/resume and lockscreen icon stability' \
                    'options nvidia_drm modeset=1' \
                    'options nvidia_drm fbdev=1' \
                    'options nvidia NVreg_PreserveVideoMemoryAllocations=1' \
                    'options nvidia NVreg_TemporaryFilePath=/var/tmp' \
                    'options nvidia NVreg_EnableGpuFirmware=0' \
                    > /etc/modprobe.d/nvidia-pm.conf; \
                echo "Regenerating initramfs for all kernels with NVIDIA modules..."; \
                dracut -f --regenerate-all && echo "Initramfs regeneration complete for all kernels" || \
                echo "Warning: dracut regeneration failed for one or more kernels, NVIDIA may not load at boot"; \
            else \
                echo "Warning: akmods failed to build NVIDIA modules"; \
                echo "NVIDIA drivers may not function properly in the installed system"; \
            fi; \
        else \
            echo "Warning: No kernel packages found, skipping akmods build"; \
        fi; \
    else \
        echo "Warning: akmods not found, NVIDIA kernel module build skipped"; \
    fi

# USB boot reliability and strict nouveau blacklist (applies regardless of akmods result)
RUN mkdir -p /etc/modprobe.d /etc/dracut.conf.d && \
    printf '%s\n' \
        '# Additional hard block for nouveau module autoload' \
        'install nouveau /bin/false' \
        'alias nouveau off' \
        > /etc/modprobe.d/blacklist-nouveau-extra.conf && \
    printf '%s\n' \
        '# Improve root device wait behavior when USB media intermittently resets' \
        'rootdelay="20"' \
        'rd.timeout="120"' \
        > /etc/dracut.conf.d/10-bootc-usb-reliability.conf

# Install CUDA Toolkit - OPTIONAL (adds ~1GB)
# To exclude, use: podman build --build-arg EXCLUDE_CUDA_TOOLKIT=yes
# Note: CUDA toolkit enables nvcc compiler and CUDA development libraries.
# ML frameworks (PyTorch, TensorFlow) can be installed post-boot via pip without precaching wheels.
# cuDNN is not included as it requires NVIDIA registration; install manually if needed.
# Offline packages are preferred if available; falls back to online repository if not.
RUN --mount=type=bind,source=offline-repo/cuda,target=/tmp/offline/cuda,readonly \
    if [ "$EXCLUDE_CUDA_TOOLKIT" != "yes" ]; then \
        offline_installed=0; \
        if compgen -G "/tmp/offline/cuda/*.rpm" >/dev/null; then \
            echo "Attempting curated CUDA install from offline repo..."; \
            mkdir -p /tmp/cuda-repo && \
            cp -a /tmp/offline/cuda/. /tmp/cuda-repo/ && \
            if dnf -y --setopt=install_weak_deps=False install createrepo_c >/dev/null 2>&1; then \
                createrepo_c /tmp/cuda-repo >/dev/null 2>&1 && \
                dnf -y --setopt=install_weak_deps=False \
                    --repofrompath="cuda-local,file:///tmp/cuda-repo" \
                    --setopt="cuda-local.gpgcheck=0" \
                    --enablerepo="cuda-local" \
                    install --best --skip-broken \
                        cuda-toolkit \
                    && offline_installed=1 && echo "CUDA packages installed successfully from offline repo" \
                || echo "Warning: curated CUDA offline install failed, falling back to online"; \
                dnf -y remove createrepo_c >/dev/null 2>&1 || true; \
            fi; \
            rm -rf /tmp/cuda-repo; \
        else \
            echo "Offline CUDA packages not found in cache"; \
        fi; \
        if [ "$offline_installed" -ne 1 ]; then \
            echo "Attempting CUDA install from online NVIDIA repository..."; \
            mkdir -p /etc/yum.repos.d && \
            curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/fedora43/x86_64/cuda-fedora43.repo \
                -o /etc/yum.repos.d/cuda-fedora43.repo 2>/dev/null || \
                echo "Warning: Could not download CUDA repo configuration from NVIDIA"; \
            dnf -y --setopt=install_weak_deps=False install --best --skip-broken \
                cuda-toolkit \
                2>/dev/null || \
                echo "Note: CUDA Toolkit packages not available; can be installed post-boot via: dnf install -y cuda-toolkit"; \
        fi; \
        dnf -y clean all && rm -rf /var/cache/dnf 2>/dev/null || true; \
        if [ -d /usr/local/cuda/bin ]; then \
            printf 'export PATH="/usr/local/cuda/bin${PATH:+:${PATH}}"\n' \
                > /etc/profile.d/cuda-toolkit.sh && \
            chmod 644 /etc/profile.d/cuda-toolkit.sh && \
            echo "CUDA bin path added to /etc/profile.d/cuda-toolkit.sh"; \
        fi; \
        echo "CUDA Toolkit install step completed"; \
    else \
        echo "CUDA Toolkit excluded (use --build-arg EXCLUDE_CUDA_TOOLKIT=no to include)"; \
    fi

# Install VS Code (offline preferred, online fallback — either path must succeed)
RUN --mount=type=bind,source=offline-repo/vscode,target=/tmp/offline/vscode,readonly \
    if [ -n "$(find /tmp/offline/vscode/ -maxdepth 1 -type f -name '*.rpm' 2>/dev/null)" ]; then \
        echo "Installing VS Code from offline repo..."; \
        find /tmp/offline/vscode/ -maxdepth 1 -type f -name 'code-*.rpm' -exec dnf -y install {} \; ; \
    else \
        echo "Offline VS Code package not found, installing from Microsoft repo..."; \
        rpm --import https://packages.microsoft.com/keys/microsoft.asc && \
        sh -c 'echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" > /etc/yum.repos.d/vscode.repo' && \
        dnf -y install code; \
    fi && \
    command -v code >/dev/null 2>&1 || { echo "ERROR: VS Code was not installed — place an RPM in offline-repo/vscode/ or ensure network access during build"; exit 1; } && \
    dnf -y clean all && rm -rf /var/cache/dnf

