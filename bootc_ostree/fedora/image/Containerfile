# Install Lutris Runners (Dw Proton, DXVK, VKD3D-Proton, Proton-GE) from offline repo
RUN --mount=type=bind,source=offline-repo/lutris-runners,target=/tmp/offline/lutris-runners,readonly \
    echo "Setting up Lutris runners (Dw Proton, DXVK, VKD3D-Proton, Proton-GE)..." && \
    mkdir -p /opt/lutris-runners && \
    RUNNERS_DIR="/opt/lutris-runners" && \
    if [ -n "$(find /tmp/offline/lutris-runners -maxdepth 1 -type f \( -name '*.tar.gz' -o -name '*.zip' \) 2>/dev/null)" ]; then \
        echo "  Installing runners from offline repo..."; \
        for runner_file in /tmp/offline/lutris-runners/*.tar.gz; do \
            if [ -f "$runner_file" ]; then \
                runner_name=$(basename "$runner_file" .tar.gz); \
                echo "    Extracting: $runner_name"; \
                tar -xzf "$runner_file" -C "$RUNNERS_DIR" 2>/dev/null || true; \
            fi; \
        done; \
        for runner_file in /tmp/offline/lutris-runners/*.tar.xz; do \
            if [ -f "$runner_file" ]; then \
                runner_name=$(basename "$runner_file" .tar.xz); \
                echo "    Extracting: $runner_name"; \
                tar -xJf "$runner_file" -C "$RUNNERS_DIR" 2>/dev/null || true; \
            fi; \
        done; \
        for runner_file in /tmp/offline/lutris-runners/*.tar.zst; do \
            if [ -f "$runner_file" ]; then \
                runner_name=$(basename "$runner_file" .tar.zst); \
                echo "    Extracting: $runner_name"; \
                tar -I zstd -xf "$runner_file" -C "$RUNNERS_DIR" 2>/dev/null || true; \
            fi; \
        done; \
        for runner_file in /tmp/offline/lutris-runners/*.zip; do \
            if [ -f "$runner_file" ]; then \
                runner_name=$(basename "$runner_file" .zip); \
                echo "    Extracting: $runner_name"; \
                command -v unzip >/dev/null 2>&1 && unzip -q "$runner_file" -d "$RUNNERS_DIR" 2>/dev/null || true; \
            fi; \
        done; \
    else \
        echo "  Offline Lutris runners not found. Install them post-boot using Lutris GUI or:"; \
        echo "    lutris --runner=dw-proton --runner=dxvk --runner=vkd3d-proton"; \
    fi && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Install helper script for managing Lutris runners
RUN mkdir -p /usr/local/bin/bootc && \
    printf '%s\n' \
        '#!/usr/bin/env bash' \
        '# Helper script to set up Lutris runners from offline artifacts' \
        'set -euo pipefail' \
        '' \
        'RUNNERS_DIR="/opt/lutris-runners"' \
        'LUTRIS_RUNNERS_DIR="${HOME}/.local/share/lutris/runners"' \
        '' \
        'if [ ! -d "$RUNNERS_DIR" ]; then' \
        '    echo "No offline Lutris runners found at $RUNNERS_DIR"' \
        '    echo "Use Lutris GUI to download runners, or run: lutris --runner=<name>"' \
        '    exit 0' \
        'fi' \
        '' \
        'mkdir -p "$LUTRIS_RUNNERS_DIR"' \
        '' \
        'echo "Linking Lutris runners from $RUNNERS_DIR..."' \
        'for runner in "$RUNNERS_DIR"/*; do' \
        '    if [ -d "$runner" ]; then' \
        '        runner_name=$(basename "$runner")' \
        '        target="$LUTRIS_RUNNERS_DIR/$runner_name"' \
        '        if [ ! -e "$target" ]; then' \
        '            ln -s "$runner" "$target"' \
        '            echo "  Linked: $runner_name"' \
        '        fi' \
        '    fi' \
        'done' \
        '' \
        'echo "Lutris runners setup complete."' \
        > /usr/local/bin/bootc/setup-lutris-runners.sh && \
    chmod 0755 /usr/local/bin/bootc/setup-lutris-runners.sh

