# Create JavaScript frameworks installer
# Prefer pre-cached npm tarballs (if provided by offline repo)
COPY offline-repo/npm-packages/ /opt/npm-packages/

# Create offline npm cache and install JS frameworks from cache
RUN mkdir -p /opt/npm-packages && \
    set -eux; \
    # If we already have cached tarballs (from offline-repo), prefer them and skip network operations
    if ls /opt/npm-packages/*.tgz >/dev/null 2>&1; then \
        echo "Using cached npm tarballs in /opt/npm-packages"; \
    else \
        echo "No cached npm tarballs found; attempting to fetch and pack (requires network)"; \
        # Avoid writing to /root during build (some build environments make /root non-writable or non-dir)
        export HOME=/tmp && mkdir -p /tmp/.npm && npm config set cache /tmp/.npm --global || true; \
        for pkg in create-react-app @vue/cli @angular/cli create-next-app vite webpack webpack-cli typescript ts-node jest mocha eslint prettier pnpm; do \
            echo "Packing $pkg"; \
            npm pack "$pkg" --pack-destination /opt/npm-packages || echo "Warning: npm pack failed for $pkg"; \
        done; \
    fi; \
    if ls /opt/npm-packages/*.tgz >/dev/null 2>&1; then \
        echo "Installing JS frameworks from offline cache..."; \
        # Ensure npm uses /tmp (some build envs make /root a file or non-writable) and set cache to /tmp/.npm
        export HOME=/tmp && mkdir -p /tmp/.npm && npm config set cache /tmp/.npm --global || true; \
        npm install -g --cache /tmp/.npm /opt/npm-packages/*.tgz || echo "Warning: npm install -g from cache failed"; \
    else \
        echo "No npm packages were cached; skipping global install"; \
    fi

# Create JavaScript frameworks verifier (checks cache and installed binaries)
RUN cat > /usr/local/bin/bootc/install-js-frameworks.sh <<'EOF'
#!/bin/bash
set -euo pipefail

CACHE="/opt/npm-packages"
PKGS=(create-react-app @vue/cli @angular/cli create-next-app vite webpack webpack-cli typescript ts-node jest mocha eslint prettier pnpm)
declare -A BINMAP
BINMAP=( ["@vue/cli"]="vue" ["@angular/cli"]="ng" ["webpack-cli"]="webpack" ["typescript"]="tsc" )

if [ ! -d "$CACHE" ]; then
    echo "No offline npm cache found at $CACHE"
    exit 1
fi

missing=0
for pkg in "${PKGS[@]}"; do
    # default binary name is basename(package)
    bin="${BINMAP[$pkg]:-$(basename "$pkg") }"
    if command -v "$bin" >/dev/null 2>&1; then
        echo "OK: $bin"
    else
        echo "MISSING: $bin"
        missing=1
    fi
done

if [ $missing -eq 0 ]; then
    echo "All JS tools present"
    exit 0
fi

echo "To install missing tools from the offline cache run:"
echo "  sudo npm install -g /opt/npm-packages/*.tgz"
exit 2
EOF
RUN chmod +x /usr/local/bin/bootc/install-js-frameworks.sh

# Create automount script for separate hard drive
RUN cat > /usr/local/bin/bootc/automount-drive.sh <<'EOF'
#!/bin/bash
set -euo pipefail

DEVICE="${1:-/dev/sda1}"
MOUNT_POINT="${2:-.mountpoint}"

usage() {
cat <<'USAGE'
Usage: automount-drive.sh [device] [mount_point]
  device       - Block device to mount (default: /dev/sda1)
  mount_point  - Relative mount point in user home (default: .mountpoint)

This script attempts to mount a separate hard drive and make it accessible to the current user.
Example: automount-drive.sh /dev/sda1 /mnt/data

USAGE
}

if [[ "$DEVICE" == "-h" ]] || [[ "$DEVICE" == "--help" ]]; then
    usage
    exit 0
fi

if [ ! -e "$DEVICE" ]; then
    echo "Error: Device $DEVICE not found"
    exit 1
fi

# Determine mount point (absolute or relative to home)
if [[ "$MOUNT_POINT" == /* ]]; then
    TARGET_MOUNT="$MOUNT_POINT"
else
    TARGET_MOUNT="$HOME/$MOUNT_POINT"
fi

echo "Attempting to mount $DEVICE to $TARGET_MOUNT"

# Check if device is already mounted
if mountpoint -q "$TARGET_MOUNT" 2>/dev/null; then
    echo "$DEVICE is already mounted at $TARGET_MOUNT"
    exit 0
fi

# Create mount point if it doesn't exist
if [ ! -d "$TARGET_MOUNT" ]; then
    echo "Creating mount point: $TARGET_MOUNT"
    mkdir -p "$TARGET_MOUNT"
fi

# Detect filesystem and mount with appropriate options
echo "Detecting filesystem on $DEVICE..."
FSTYPE=$(sudo blkid -o value -s TYPE "$DEVICE" 2>/dev/null || echo "auto")
echo "Detected filesystem: $FSTYPE"

# Mount with appropriate flags based on filesystem
case "$FSTYPE" in
    ntfs|exfat|vfat)
        echo "Mounting with user-friendly options for $FSTYPE"
        sudo mount -t "$FSTYPE" -o umask=0022,dmask=0022,fmask=0133,uid=$(id -u),gid=$(id -g) "$DEVICE" "$TARGET_MOUNT"
        ;;
    *)
        echo "Mounting with default options"
        sudo mount -t "$FSTYPE" "$DEVICE" "$TARGET_MOUNT"
        # Try to make writable for current user if not already
        sudo chown "$(id -u):$(id -g)" "$TARGET_MOUNT" 2>/dev/null || true
        ;;
esac

echo "✓ Successfully mounted $DEVICE to $TARGET_MOUNT"
echo "To unmount later, run: sudo umount $TARGET_MOUNT"
EOF
RUN chmod +x /usr/local/bin/bootc/automount-drive.sh

# Install OpenShift/Kubernetes CLI tools from pre-downloaded cache
RUN --mount=type=bind,source=offline-repo/openshift,target=/tmp/offline/openshift,readonly \
    OPENSHIFT_DIR="/tmp/offline/openshift" && \
    INSTALL_DIR="/usr/local/bin/bootc" && \
    echo "Installing OpenShift/Kubernetes tools from cache..." && \
    if [ -f "$OPENSHIFT_DIR/oc" ]; then \
        install -m 0755 "$OPENSHIFT_DIR/oc" "$INSTALL_DIR/oc" && \
        echo "✓ oc installed from cache" && \
        oc version --client 2>/dev/null || true; \
    else \
        echo "⚠ oc binary not found in $OPENSHIFT_DIR (optional)"; \
    fi && \
    if [ -f "$OPENSHIFT_DIR/kubectl" ]; then \
        install -m 0755 "$OPENSHIFT_DIR/kubectl" "$INSTALL_DIR/kubectl" && \
        echo "✓ kubectl installed from cache" && \
        kubectl version --client 2>/dev/null || true; \
    else \
        echo "⚠ kubectl binary not found in $OPENSHIFT_DIR (optional)"; \
    fi && \
    echo "OpenShift/Kubernetes CLI tools installation complete"

# Create symlinks for oc and kubectl to make them available in system PATH
RUN INSTALL_DIR="/usr/local/bin/bootc" && \
    if [ -f "$INSTALL_DIR/oc" ]; then \
        ln -sf "$INSTALL_DIR/oc" /usr/local/bin/oc && \
        echo "✓ Symlinked oc to /usr/local/bin/oc"; \
    fi && \
    if [ -f "$INSTALL_DIR/kubectl" ]; then \
        ln -sf "$INSTALL_DIR/kubectl" /usr/local/bin/kubectl && \
        ln -sf "$INSTALL_DIR/kubectl" /usr/local/bin/k && \
        echo "✓ Symlinked kubectl to /usr/local/bin/kubectl and /usr/local/bin/k"; \
    fi

# Install helm from offline cache (if available)
RUN --mount=type=bind,source=offline-repo/helm,target=/tmp/offline/helm,readonly \
    if [ -f "/tmp/offline/helm/helm" ]; then \
        echo "Installing helm from offline cache..."; \
        install -m 0755 /tmp/offline/helm/helm /usr/local/bin/helm && \
        echo "✓ helm installed from cache: $(helm version 2>/dev/null | head -1 || echo 'version check skipped')"; \
    else \
        echo "⚠ helm binary not found in offline-repo/helm/"; \
        echo "  Run fetch_helm.sh to download: ./bootc_ostree/fedora/image/scripts/fetch_helm.sh"; \
    fi

# Stage k3s binary and air-gap images for offline installs
RUN --mount=type=bind,source=offline-repo/k3s,target=/tmp/offline/k3s,readonly \
    INSTALL_DIR="/usr/local/bin" && \
    if [ -f "/tmp/offline/k3s/k3s" ]; then \
        echo "Installing k3s binary from offline cache..."; \
        install -m 0755 /tmp/offline/k3s/k3s "$INSTALL_DIR/k3s" && \
        echo "✓ k3s installed: $($INSTALL_DIR/k3s --version 2>/dev/null | head -1 || echo 'version check skipped')"; \
    else \
        echo "⚠ k3s binary not found in offline-repo/k3s/"; \
        echo "  Run fetch_k3s_binary.sh to download: ./bootc_ostree/fedora/image/scripts/fetch_k3s_binary.sh"; \
    fi && \
    if [ -n "$(ls -A /tmp/offline/k3s/k3s-airgap-images-*.tar.zst 2>/dev/null)" ]; then \
        echo "Staging k3s air-gap images to /usr/share/k3s..."; \
        mkdir -p /usr/share/k3s; \
        cp /tmp/offline/k3s/k3s-airgap-images-*.tar.zst /usr/share/k3s/; \
        if [ -n "$(ls -A /tmp/offline/k3s/sha256sum-*.txt 2>/dev/null)" ]; then \
            cp /tmp/offline/k3s/sha256sum-*.txt /usr/share/k3s/; \
        fi; \
        chmod 644 /usr/share/k3s/k3s-airgap-images-*.tar.zst; \
        chmod 644 /usr/share/k3s/sha256sum-*.txt 2>/dev/null || true; \
        echo "✓ k3s air-gap artifacts staged"; \
        echo "  Copy into place at runtime: /var/lib/rancher/k3s/agent/images/"; \
    else \
        echo "⚠ No k3s air-gap artifacts found in offline-repo/k3s/"; \
        echo "  Run fetch_k3s_images.sh to download: ./bootc_ostree/fedora/image/scripts/fetch_k3s_images.sh"; \
    fi

# Configure k3s for air-gapped operation.
# - write-kubeconfig-mode 0644 so regular users can read k3s.yaml without sudo
# - flannel-backend vxlan is explicit and works fully offline (no external IPAM)
# - node-name pins the hostname so cluster certificates stay valid after reboots
RUN mkdir -p /etc/rancher/k3s && \
    cat > /etc/rancher/k3s/config.yaml <<'K3SCFGEOF'
# Kubeconfig is owner-readable only (0600). The k3s-kubeconfig-distribute.service
# copies it per-user at runtime with chmod 600, so no world-readable admin token.
write-kubeconfig-mode: "0600"
# Explicit flannel backend — vxlan works in fully air-gapped environments
flannel-backend: "vxlan"
# SELinux enforcement left at the k3s default (enabled). Install k3s-selinux
# policy package if container workloads require SELinux policy adjustments.
K3SCFGEOF
# Pre-create the config drop-in directory so ExecStartPre can write to it
# without needing to create directories on a potentially read-only /etc.
RUN mkdir -p /etc/rancher/k3s/config.yaml.d

# Ensure kernel modules required by k3s / flannel are loaded at boot.
# systemd-modules-load.service reads /etc/modules-load.d/ before k3s starts.
RUN mkdir -p /etc/modules-load.d && \
    printf 'overlay\nbr_netfilter\ndummy\n' > /etc/modules-load.d/k3s.conf

# Make plain `kubectl` and `oc` work out of the box.
# If the user already has ~/.kube/config (written by k3s-kubeconfig-distribute.service),
# that takes precedence. Otherwise fall back to the per-user 0600 copy once it exists,
# or the root-owned 0600 source for root itself.
# KUBECONFIG fallback for LOGIN shells (bash, zsh, sh via /etc/profile.d)
RUN printf '# k3s kubeconfig fallback — lets plain kubectl reach the k3s server.\n' \
          '# /etc/rancher/k3s/k3s.yaml is root-readable only (write-kubeconfig-mode: 0600).\n' \
          '# The k3s-kubeconfig-distribute.service copies it to ~/.kube/config (chmod 600)\n' \
          '# for each local user when k3s.service activates.\n' \
          'if [ -z "${KUBECONFIG:-}" ] && [ ! -f "${HOME}/.kube/config" ]; then\n' \
          '    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml\n' \
          'fi\n' \
    > /etc/profile.d/k3s-kubectl.sh && \
    chmod 644 /etc/profile.d/k3s-kubectl.sh

# KUBECONFIG fallback for NON-LOGIN interactive shells (desktop terminal apps, tmux, etc.).
# Fedora sources /etc/bashrc.d/*.sh from /etc/bashrc for every bash session.
RUN mkdir -p /etc/bashrc.d && \
    printf '# k3s kubeconfig fallback for interactive non-login shells\n' \
           'if [ -z "${KUBECONFIG:-}" ] && [ ! -f "${HOME}/.kube/config" ]; then\n' \
           '    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml\n' \
           'fi\n' \
    > /etc/bashrc.d/k3s-kubectl.sh && \
    chmod 644 /etc/bashrc.d/k3s-kubectl.sh

    # Just load the image separately at runtime instead of copying into the image, since it can be very large and we want to avoid bloating the image if not needed. Provide instructions for users to load it manually from the shared location.
# Copy Triton Server container image (if present) to user share location
# Users can load it with: podman load -i ~/.local/share/triton/tritonserver-*.tar
# COPY offline-repo/triton/ /tmp/triton/
# RUN if [ -n "$(ls -A /tmp/triton/*.tar 2>/dev/null)" ]; then \
#         echo "Copying Triton Server container image to shared location..."; \
#         mkdir -p /usr/share/triton; \
#         cp /tmp/triton/*.tar /usr/share/triton/; \
#         chmod 644 /usr/share/triton/*.tar; \
#         echo "✓ Triton Server image copied to /usr/share/triton/"; \
#         echo "  Load with: podman load -i /usr/share/triton/tritonserver-*.tar"; \
#     fi && \
#     rm -rf /tmp/triton

# Create consolidated post-install script
RUN cat > /usr/local/bin/bootc/bootc-post-install.sh <<'EOF'
#!/bin/bash
set -euo pipefail

README_SRC="/usr/local/bin/bootc/BOOTC-README.md"

usage() {
cat <<'USAGE'
Usage: bootc-post-install.sh [options] [user...]
    --bootc-user NAME      Username to create for the bootc user step
    --bootc-password PASS  Password to set for the bootc user step
  --skip-extensions     Skip VS Code extensions
  --skip-readme         Skip copying README to user desktops
    --skip-services       Skip enabling GUI services (display manager/xrdp/graphical target)
  --skip-nvidia         Skip NVIDIA driver verification
    --run-nvidia-diagnostics  Run NVIDIA hybrid diagnostics report
  --skip-docker         Skip adding users to docker group
  --skip-podman         Skip podman user socket enable
    --skip-create-user    Skip creating the configured bootc user
    --only-steps LIST     Run only selected steps (comma-separated). Choices: create-user,extensions,readme,services,nvidia,nvidia-diagnostics,docker,podman
  -h, --help            Show this help

Users (optional): if provided, VS Code extensions install only for those users. Defaults to all local users.
USAGE


if [[ $EUID -ne 0 ]]; then
    echo "Error: This script must be run as root (use: sudo /usr/local/bin/bootc/bootc-post-install.sh)"
    exit 1
fi

RUN_BASE=1
RUN_EXT=1
RUN_README=1
RUN_SERVICES=1
RUN_NVIDIA_STEP=1
RUN_NVIDIA_DIAG=0
RUN_DOCKER_GROUP=1
RUN_PODMAN=1
RUN_CREATE_USER=1
ONLY_MODE=0
BOOTC_CREATE_USER_NAME=""
BOOTC_CREATE_USER_PASSWORD=""

disable_all_base_steps() {
    RUN_EXT=0
    RUN_README=0
    RUN_SERVICES=0
    RUN_NVIDIA_STEP=0
    RUN_NVIDIA_DIAG=0
    RUN_DOCKER_GROUP=0
    RUN_PODMAN=0
    RUN_CREATE_USER=0
}

normalize_step() {
    local raw="${1,,}"
    raw="${raw//-/_}"
    case "$raw" in
        create_user|createuser|create_bootcuser) echo "create_user" ;;
        extension|extensions) echo "extensions" ;;
        readme|desktop_readme|readme_desktop) echo "readme" ;;
        service|services) echo "services" ;;
        nvidia|gpu) echo "nvidia" ;;
        nvidia_diagnostics|nvidia_diagnostic|diagnostics|diagnostic|diag) echo "nvidia_diagnostics" ;;
        docker|docker_group) echo "docker" ;;
        podman|podman_socket) echo "podman" ;;
        *) echo "" ;;
    esac
}

select_only_steps() {
    local list="$1"
    [[ $ONLY_MODE -eq 0 ]] && disable_all_base_steps
    ONLY_MODE=1

    IFS=',' read -ra parts <<< "$list"
    for raw in "${parts[@]}"; do
        local step
        step=$(normalize_step "$raw")
        case "$step" in
            create_user) RUN_CREATE_USER=1 ;;
            extensions) RUN_EXT=1 ;;
            readme) RUN_README=1 ;;
            services) RUN_SERVICES=1 ;;
            nvidia) RUN_NVIDIA_STEP=1 ;;
            nvidia_diagnostics) RUN_NVIDIA_DIAG=1 ;;
            docker) RUN_DOCKER_GROUP=1 ;;
            podman) RUN_PODMAN=1 ;;
            "") echo "Unknown step: $raw (use: create-user, extensions, readme, services, nvidia, nvidia-diagnostics, docker, podman)" ;;
        esac
    done
}

declare -a USER_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --bootc-user)
            [ $# -ge 2 ] || { echo "Missing value for $1"; exit 1; }
            BOOTC_CREATE_USER_NAME="$2"; shift 2 ;;
        --bootc-user=*)
            BOOTC_CREATE_USER_NAME="${1#*=}"; shift ;;
        --bootc-password)
            [ $# -ge 2 ] || { echo "Missing value for $1"; exit 1; }
            echo "WARNING: --bootc-password passes credentials via command-line arguments," >&2
            echo "         which are visible in 'ps aux' and /proc/<pid>/cmdline." >&2
            echo "         Prefer --bootc-password-file /path/to/file for non-interactive use." >&2
            BOOTC_CREATE_USER_PASSWORD="$2"; shift 2 ;;
        --bootc-password=*)
            echo "WARNING: --bootc-password passes credentials via command-line arguments," >&2
            echo "         which are visible in 'ps aux' and /proc/<pid>/cmdline." >&2
            echo "         Prefer --bootc-password-file /path/to/file for non-interactive use." >&2
            BOOTC_CREATE_USER_PASSWORD="${1#*=}"; shift ;;
        --bootc-password-file)
            [ $# -ge 2 ] || { echo "Missing value for $1"; exit 1; }
            [ -r "$2" ] || { echo "Error: cannot read password file '$2'"; exit 1; }
            BOOTC_CREATE_USER_PASSWORD=$(cat "$2"); shift 2 ;;
        --bootc-password-file=*)
            _pwfile="${1#*=}"
            [ -r "$_pwfile" ] || { echo "Error: cannot read password file '$_pwfile'"; exit 1; }
            BOOTC_CREATE_USER_PASSWORD=$(cat "$_pwfile"); shift ;;
        --skip-extensions|--no-extensions)
            RUN_EXT=0; shift ;;
        --skip-readme|--no-readme)
            RUN_README=0; shift ;;
        --skip-services|--no-services)
            RUN_SERVICES=0; shift ;;
        --skip-nvidia|--no-nvidia)
            RUN_NVIDIA_STEP=0; shift ;;
        --run-nvidia-diagnostics|--nvidia-diagnostics)
            RUN_NVIDIA_DIAG=1; shift ;;
        --skip-docker|--no-docker|--skip-docker-group)
            RUN_DOCKER_GROUP=0; shift ;;
        --skip-podman|--no-podman)
            RUN_PODMAN=0; shift ;;
        --skip-create-user|--no-create-user)
            RUN_CREATE_USER=0; shift ;;
        --only-steps)
            [ $# -ge 2 ] || { echo "Missing value for $1"; exit 1; }
            select_only_steps "$2"; shift 2 ;;
        --only-steps=*)
            select_only_steps "${1#*=}"; shift ;;
        -h|--help)
            usage; exit 0 ;;
        *)
            USER_ARGS+=("$1"); shift ;;
    esac
done

echo "BOOTC Post-Install: starting"
step=1
next_step() { echo "Step $step: $1"; step=$((step+1)); }

valid_linux_username() {
    [[ "$1" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]
}

prompt_for_bootc_user_details() {
    local password_confirm

    if [[ -z "$BOOTC_CREATE_USER_NAME" ]]; then
        if [[ -t 0 ]]; then
            while true; do
                read -r -p "Enter username for bootc user [BOOTCUser]: " BOOTC_CREATE_USER_NAME
                BOOTC_CREATE_USER_NAME="${BOOTC_CREATE_USER_NAME:-BOOTCUser}"
                if valid_linux_username "$BOOTC_CREATE_USER_NAME"; then
                    break
                fi
                echo "  Invalid username '$BOOTC_CREATE_USER_NAME'. Use lowercase letters, digits, underscores, or dashes."
            done
        else
            echo "Error: bootc user creation needs --bootc-user when stdin is not interactive"
            exit 1
        fi
    elif ! valid_linux_username "$BOOTC_CREATE_USER_NAME"; then
        echo "Error: invalid --bootc-user value '$BOOTC_CREATE_USER_NAME'"
        exit 1
    fi

    if [[ -z "$BOOTC_CREATE_USER_PASSWORD" ]]; then
        if [[ -t 0 ]]; then
            while true; do
                read -r -s -p "Enter password for $BOOTC_CREATE_USER_NAME: " BOOTC_CREATE_USER_PASSWORD
                echo
                read -r -s -p "Confirm password for $BOOTC_CREATE_USER_NAME: " password_confirm
                echo

                if [[ -z "$BOOTC_CREATE_USER_PASSWORD" ]]; then
                    echo "  Password cannot be empty."
                    continue
                fi

                if [[ "$BOOTC_CREATE_USER_PASSWORD" != "$password_confirm" ]]; then
                    echo "  Passwords do not match."
                    BOOTC_CREATE_USER_PASSWORD=""
                    continue
                fi

                break
            done
        else
            echo "Error: bootc user creation needs --bootc-password when stdin is not interactive"
            exit 1
        fi
    fi
}

register_samba_user_with_password() {
    local samba_user="$1"
    local samba_password="$2"

    if ! command -v smbpasswd >/dev/null 2>&1; then
        return 0
    fi

    if command -v pdbedit >/dev/null 2>&1 && pdbedit -L -u "$samba_user" >/dev/null 2>&1; then
        printf '%s\n%s\n' "$samba_password" "$samba_password" | \
            smbpasswd -s "$samba_user" 2>/dev/null && \
            echo "  Updated Samba password for $samba_user" || \
            echo "  Warning: Samba password update failed; run 'sudo smbpasswd $samba_user' manually"
    else
        printf '%s\n%s\n' "$samba_password" "$samba_password" | \
            smbpasswd -a -s "$samba_user" 2>/dev/null && \
            echo "  Registered $samba_user in Samba database" || \
            echo "  Warning: smbpasswd registration failed; run 'sudo smbpasswd -a $samba_user' manually"
    fi
}

prompt_for_existing_samba_user_password() {
    local samba_user="$1"
    local samba_password=""
    local password_confirm=""

    while true; do
        read -r -s -p "Enter Samba password for existing user $samba_user: " samba_password
        echo >&2
        read -r -s -p "Confirm Samba password for existing user $samba_user: " password_confirm
        echo >&2

        if [[ -z "$samba_password" ]]; then
            echo "  Password cannot be empty." >&2
            continue
        fi

        if [[ "$samba_password" != "$password_confirm" ]]; then
            echo "  Passwords do not match." >&2
            continue
        fi

        printf '%s' "$samba_password"
        return 0
    done
}

register_invoking_user_in_samba() {
    local bootc_user="$1"
    local admin_user="${SUDO_USER:-}"
    local response
    local samba_password

    [ -n "$admin_user" ] || return 0
    [ "$admin_user" != "root" ] || return 0
    [ "$admin_user" != "$bootc_user" ] || return 0
    getent passwd "$admin_user" >/dev/null 2>&1 || return 0

    if command -v pdbedit >/dev/null 2>&1 && pdbedit -L -u "$admin_user" >/dev/null 2>&1; then
        echo "  Samba account already present for $admin_user"
        return 0
    fi

    if [[ -t 0 ]]; then
        read -r -p "Register Samba access for existing user $admin_user as well? [Y/n]: " response
        case "${response,,}" in
            n|no)
                echo "  Skipping Samba registration for $admin_user"
                return 0
                ;;
        esac

        samba_password=$(prompt_for_existing_samba_user_password "$admin_user")
        register_samba_user_with_password "$admin_user" "$samba_password"
    else
        echo "  Note: existing user $admin_user is not registered in Samba; run 'sudo smbpasswd -a $admin_user' to enable network share login"
    fi
}

create_bootcuser() {
    local BOOTC_USER
    local BOOTC_HOME

    prompt_for_bootc_user_details
    BOOTC_USER="$BOOTC_CREATE_USER_NAME"

    if getent passwd "$BOOTC_USER" >/dev/null 2>&1; then
        echo "  User $BOOTC_USER already exists, skipping creation"
        register_invoking_user_in_samba "$BOOTC_USER"
        return 0
    fi

    echo "  Creating user $BOOTC_USER..."
    if useradd -m -s /bin/bash "$BOOTC_USER" 2>/dev/null; then
        echo "  User $BOOTC_USER created successfully"

        BOOTC_HOME=$(getent passwd "$BOOTC_USER" | awk -F: '{print $6}')
        BOOTC_HOME="${BOOTC_HOME:-/var/home/$BOOTC_USER}"

        # Relax home dir permissions so other authenticated users can traverse it via Samba
        chmod 755 "$BOOTC_HOME" 2>/dev/null || true

        printf '%s:%s\n' "$BOOTC_USER" "$BOOTC_CREATE_USER_PASSWORD" | chpasswd 2>/dev/null || true
        echo "  Password set for $BOOTC_USER"

        # Register the user in the Samba database so network drive access works
        # with the same credentials as the Linux login password.
        register_samba_user_with_password "$BOOTC_USER" "$BOOTC_CREATE_USER_PASSWORD"
        register_invoking_user_in_samba "$BOOTC_USER"

        # Add bootc user to docker group if docker group exists
        if getent group docker >/dev/null 2>&1; then
            usermod -aG docker "$BOOTC_USER" 2>/dev/null || true
            echo "  Added $BOOTC_USER to docker group"
        fi

        # Copy README to the configured bootc user desktop
        if [ -f "$README_SRC" ]; then
            mkdir -p "$BOOTC_HOME/Desktop"
            chown "$BOOTC_USER:$BOOTC_USER" "$BOOTC_HOME/Desktop"
            cp "$README_SRC" "$BOOTC_HOME/Desktop/BOOTC-README.md"
            chown "$BOOTC_USER:$BOOTC_USER" "$BOOTC_HOME/Desktop/BOOTC-README.md"
            echo "  Copied README to $BOOTC_USER Desktop"
        fi
    else
        echo "  Warning: failed to create user $BOOTC_USER"
        return 1
    fi
}

verify_time_sync() {
    echo "Verifying system time synchronization..."
    
    # Check ntpdate-sync service status
    local NTPDATE_STATUS
    NTPDATE_STATUS=$(systemctl is-active ntpdate-sync.service 2>/dev/null || echo "unknown")
    
    # Check chronyd service status
    local CHRONYD_STATUS
    CHRONYD_STATUS=$(systemctl is-active chronyd.service 2>/dev/null || echo "unknown")
    
    echo "  ntpdate-sync.service: $NTPDATE_STATUS"
    echo "  chronyd.service: $CHRONYD_STATUS"
    
    # Show last sync time from chrony
    if command -v chronyc >/dev/null 2>&1; then
        echo "  chronyc tracking:"
        chronyc tracking 2>/dev/null | grep -E "System time|RMS offset|Reference" | sed 's/^/    /' || echo "    (chronyc info unavailable)"
    fi
    
    # Warn if ntpdate-sync failed
    if [ "$NTPDATE_STATUS" != "inactive" ] && [ "$NTPDATE_STATUS" != "active" ]; then
        echo "  ⚠️  WARNING: ntpdate-sync.service status is '$NTPDATE_STATUS' — initial time sync may not have completed"
        echo "      k3s certificate generation may use incorrect timestamps"
        echo "      Try: sudo systemctl restart ntpdate-sync.service chronyd.service"
        return 1
    fi
    
    return 0
}

ensure_k3s_kubeconfig_for_user() {
    local U="$1"
    local HOME_DIR="$2"
    local KUBE_DIR="$HOME_DIR/.kube"
    local USER_KUBECONFIG="$KUBE_DIR/config"
    local K3S_KUBECONFIG="/etc/rancher/k3s/k3s.yaml"

    [ -n "$U" ] || return 0
    [ -d "$HOME_DIR" ] || return 0

    mkdir -p "$KUBE_DIR"
    chown "$U:$U" "$KUBE_DIR"
    chmod 700 "$KUBE_DIR"

    if [ -f "$K3S_KUBECONFIG" ]; then
        cp "$K3S_KUBECONFIG" "$USER_KUBECONFIG"
        chown "$U:$U" "$USER_KUBECONFIG"
        chmod 600 "$USER_KUBECONFIG"
        echo "  k3s kubeconfig copied to $USER_KUBECONFIG"
    else
        # k3s may not have started yet; use a forward-looking symlink so plain kubectl works once it does.
        ln -sfn "$K3S_KUBECONFIG" "$USER_KUBECONFIG"
        chown -h "$U:$U" "$USER_KUBECONFIG" 2>/dev/null || true
        echo "  k3s kubeconfig not present yet; linked $USER_KUBECONFIG -> $K3S_KUBECONFIG"
    fi
}

install_extensions_for_user() {
    local U="$1"
    [ -n "$U" ] || return 0

    local HOME_DIR
    HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
    [ -d "$HOME_DIR" ] || { echo "Home not found for $U"; return 0; }

    if ! command -v code >/dev/null 2>&1; then
        echo "VS Code not found; skipping for $U"
        return 0
    fi

    echo "Installing VS Code extensions for user $U..."
    mkdir -p "$HOME_DIR/.vscode/extensions"
    chown -R "$U":"$U" "$HOME_DIR/.vscode"

    for VSIX in /opt/vscode-extensions/*.vsix; do
        [ -f "$VSIX" ] || continue
        echo "  Installing $(basename "$VSIX")"
        sudo -u "$U" HOME="$HOME_DIR" code --install-extension "$VSIX" --no-sandbox --force 2>/dev/null || echo "  Warning: extension install failed, continuing"
    done
}

enable_podman_socket_for_user() {
    local U="$1"
    local USER_UID
    USER_UID=$(id -u "$U" 2>/dev/null) || return 0

    loginctl enable-linger "$U" >/dev/null 2>&1 || echo "  Note: could not enable linger for $U (requires systemd-logind)"

    if [ ! -d "/run/user/$USER_UID" ]; then
        mkdir -p "/run/user/$USER_UID"
        chown "$USER_UID":"$USER_UID" "/run/user/$USER_UID"
        chmod 700 "/run/user/$USER_UID"
    fi

    sudo -u "$U" XDG_RUNTIME_DIR="/run/user/$USER_UID" systemctl --user enable --now podman.socket 2>/dev/null || \
        echo "  Note: Podman user socket setup failed for $U; run after login: systemctl --user enable --now podman.socket"
}


if (( RUN_BASE )); then
    next_step "Creating bootc user..."
    if (( RUN_CREATE_USER )); then
        create_bootcuser
    else
        echo "  Skipping bootc user creation (disabled by flag)"
    fi

    next_step "Installing VS Code extensions..."
    if (( RUN_EXT )); then
        if [ ${#USER_ARGS[@]} -gt 0 ]; then
            echo "  For specified users: ${USER_ARGS[*]}"
            for U in "${USER_ARGS[@]}"; do
                install_extensions_for_user "$U"
            done
        else
            echo "  For all local users..."
            mapfile -t USERS < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Found ${#USERS[@]} users: ${USERS[*]}"
            for U in "${USERS[@]}"; do
                install_extensions_for_user "$U"
            done
        fi
    else
        echo "  Skipping VS Code extensions (disabled by flag)"
    fi

    next_step "Copying README to user desktops..."
    if (( RUN_README )); then
        if [ -f "$README_SRC" ]; then
            mapfile -t USERS < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Found ${#USERS[@]} users: ${USERS[*]}"
            for U in "${USERS[@]}"; do
                HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
                [ -d "$HOME_DIR" ] || continue
                mkdir -p "$HOME_DIR/Desktop"
                chown "$U":"$U" "$HOME_DIR/Desktop"
                cp "$README_SRC" "$HOME_DIR/Desktop/BOOTC-README.md"
                chown "$U":"$U" "$HOME_DIR/Desktop/BOOTC-README.md"
                echo "  Copied to $U Desktop"
            done
        else
            echo "  README not found, skipping"
        fi
    else
        echo "  Skipping README copy (disabled by flag)"
    fi

    next_step "Enabling GUI services..."
    if (( RUN_SERVICES )); then
        if systemctl list-unit-files | grep -q '^sddm\.service'; then
            systemctl enable sddm 2>/dev/null || echo "  Warning: SDDM enable failed"
        else
            systemctl enable gdm 2>/dev/null || echo "  Warning: GDM enable failed"
        fi
        systemctl enable xrdp 2>/dev/null || echo "  Warning: XRDP enable failed"
        if systemctl list-unit-files | grep -q '^bootc-fetch-apply-updates\.timer'; then
            systemctl enable bootc-fetch-apply-updates.timer 2>/dev/null || echo "  Warning: bootc-fetch-apply-updates.timer enable failed"
        fi
        for UNIT in nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service nvidia-powerd.service switcheroo-control.service; do
            if systemctl list-unit-files | grep -q "^${UNIT}"; then
                systemctl enable "$UNIT" 2>/dev/null || echo "  Warning: $UNIT enable failed"
            fi
        done
        systemctl set-default graphical.target 2>/dev/null || echo "  Warning: graphical.target set failed"
    else
        echo "  Skipping GUI services enable (disabled by flag)"
    fi

    next_step "NVIDIA verification..."
    if (( RUN_NVIDIA_STEP )); then
        if command -v nvidia-smi >/dev/null 2>&1; then
            echo "  NVIDIA drivers detected in system image"
            echo "  Kernel modules were pre-built at image creation time"
            echo "  Run 'nvidia-smi' after reboot to verify NVIDIA driver functionality"
        else
            echo "  NVIDIA not detected, skipping"
        fi
    else
        echo "  Skipping NVIDIA verification (disabled by flag)"
    fi

    next_step "NVIDIA hybrid diagnostics..."
    if (( RUN_NVIDIA_DIAG )); then
        if [ -x /usr/local/bin/bootc/nvidia-hybrid-diagnostics.sh ]; then
            /usr/local/bin/bootc/nvidia-hybrid-diagnostics.sh || true
        else
            echo "  Diagnostics script missing: /usr/local/bin/bootc/nvidia-hybrid-diagnostics.sh"
        fi
    else
        echo "  Skipping NVIDIA diagnostics (enable with --run-nvidia-diagnostics)"
    fi

    next_step "Docker group setup..."
    if (( RUN_DOCKER_GROUP )); then
        getent group docker >/dev/null 2>&1 || groupadd -f docker || echo "  Warning: failed to create docker group"

        if getent group docker >/dev/null 2>&1; then
            mapfile -t USERS < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Found ${#USERS[@]} users: ${USERS[*]}"
            for U in "${USERS[@]}"; do
                usermod -aG docker "$U" 2>/dev/null || true
                echo "  Added $U to docker group"
            done
        else
            echo "  Docker group not available, skipping"
        fi
    else
        echo "  Skipping docker group additions (disabled by flag)"
    fi

    next_step "Podman setup..."
    if (( RUN_PODMAN )); then
        mapfile -t USERS < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
        echo "  Enabling Podman user socket for: ${USERS[*]}"
        for U in "${USERS[@]}"; do
            enable_podman_socket_for_user "$U"
        done
    else
        echo "  Skipping podman socket enable (disabled by flag)"
    fi

    next_step "Verifying system time synchronization..."
    verify_time_sync

    next_step "Preparing k3s kubeconfig for users..."
    mapfile -t USERS < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
    echo "  Found ${#USERS[@]} users: ${USERS[*]}"
    for U in "${USERS[@]}"; do
        HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
        [ -d "$HOME_DIR" ] || continue
        ensure_k3s_kubeconfig_for_user "$U" "$HOME_DIR"
    done

    next_step "Setting up Lutris runners..."
    if [[ -d /opt/lutris-runners ]]; then
        mapfile -t USERS < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
        echo "  Found ${#USERS[@]} users: ${USERS[*]}"
        for U in "${USERS[@]}"; do
            HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
            [ -d "$HOME_DIR" ] || continue
            LUTRIS_RUNNERS_DIR="$HOME_DIR/.local/share/lutris/runners"
            mkdir -p "$LUTRIS_RUNNERS_DIR"
            
            # Symlink runners from /opt/lutris-runners if not already present
            for runner in /opt/lutris-runners/*; do
                if [[ -d "$runner" ]]; then
                    runner_name=$(basename "$runner")
                    target="$LUTRIS_RUNNERS_DIR/$runner_name"
                    if [[ ! -e "$target" ]]; then
                        ln -s "$runner" "$target" 2>/dev/null || true
                        echo "    Linked $runner_name for user $U"
                    fi
                fi
            done
            chown -R "$U:$U" "$HOME_DIR/.local" 2>/dev/null || true
        done
        echo "  Lutris runners setup complete"
    else
        echo "  No offline Lutris runners found at /opt/lutris-runners"
        echo "  Users can download runners directly from Lutris GUI or run:"
        echo "    lutris --runner=dw-proton --runner=dxvk --runner=vkd3d-proton"
    fi

    next_step "Setting up Rations offline cache..."
    if [[ -d /opt/rations ]]; then
        local rations_user_choice=""
        local rations_target_users=()
        
        if [[ -t 0 ]]; then
            read -r -p "  Setup Rations offline cache for a specific user? (y/n) [n]: " rations_user_choice
            rations_user_choice="${rations_user_choice,,}"
            
            if [[ "$rations_user_choice" == "y" || "$rations_user_choice" == "yes" ]]; then
                read -r -p "  Enter username for Rations setup: " rations_target_user
                if getent passwd "$rations_target_user" >/dev/null 2>&1; then
                    rations_target_users=("$rations_target_user")
                    echo "  Setting up Rations cache for specified user: $rations_target_user"
                else
                    echo "    Warning: user '$rations_target_user' not found, skipping Rations setup"
                fi
            else
                mapfile -t rations_target_users < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
                echo "  Found ${#rations_target_users[@]} users for Rations setup: ${rations_target_users[*]}"
            fi
        else
            # Non-interactive mode: default to all users
            mapfile -t rations_target_users < <(getent passwd | awk -F: '$3 >= 1000 && $7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Non-interactive mode: setting up for all users (${#rations_target_users[@]} users)"
        fi
        
        for U in "${rations_target_users[@]}"; do
            HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
            if [[ -z "$HOME_DIR" ]] || [[ ! -d "$HOME_DIR" ]]; then
                echo "    Warning: home directory not found for user $U, skipping"
                continue
            fi
            
            # Move .minecraft if it exists in /opt/rations
            if [[ -d /opt/rations/.minecraft ]]; then
                MINECRAFT_TARGET="$HOME_DIR/.minecraft"
                if [[ ! -e "$MINECRAFT_TARGET" ]]; then
                    cp -r /opt/rations/.minecraft "$MINECRAFT_TARGET" 2>/dev/null || true
                    chown -R "$U:$U" "$MINECRAFT_TARGET" 2>/dev/null || true
                    echo "    Copied .minecraft for user $U"
                else
                    echo "    .minecraft already exists for user $U, skipping"
                fi
            fi
            
            # Move .cache if it exists in /opt/rations
            if [[ -d /opt/rations/.cache ]]; then
                CACHE_TARGET="$HOME_DIR/.cache"
                if [[ ! -e "$CACHE_TARGET" ]]; then
                    cp -r /opt/rations/.cache "$CACHE_TARGET" 2>/dev/null || true
                    chown -R "$U:$U" "$CACHE_TARGET" 2>/dev/null || true
                    echo "    Copied .cache for user $U"
                else
                    echo "    .cache already exists for user $U, skipping"
                fi
            fi
        done
        
        if [[ ${#rations_target_users[@]} -eq 0 ]]; then
            echo "  No users selected for Rations cache setup"
        else
            echo "  Rations offline cache setup complete"
        fi
    else
        echo "  No Rations offline cache found at /opt/rations, skipping"
    fi

else
    echo "Error: all base steps disabled"
    exit 1
fi

echo ""
echo "BOOTC Post-Install: complete"
echo "Note: Some services may require a reboot to take full effect"
EOF
RUN chmod +x /usr/local/bin/bootc/bootc-post-install.sh

# NVIDIA hybrid diagnostics helper
RUN cat > /usr/local/bin/bootc/nvidia-hybrid-diagnostics.sh <<'EOF'
#!/bin/bash
set -u

STRICT=0
if [[ "${1:-}" == "--strict" ]]; then
    STRICT=1
fi

PASS=0
WARN=0
FAIL=0

ok() { PASS=$((PASS+1)); echo "[PASS] $*"; }
warn() { WARN=$((WARN+1)); echo "[WARN] $*"; }
fail() { FAIL=$((FAIL+1)); echo "[FAIL] $*"; }

check_rpm() {
    local pkg="$1"
    if rpm -q "$pkg" >/dev/null 2>&1; then
        ok "Package installed: $pkg"
    else
        fail "Package missing: $pkg"
    fi
}

check_service_state() {
    local svc="$1"
    if ! systemctl list-unit-files | grep -q "^${svc}"; then
        warn "Service not present on this system: $svc"
        return 0
    fi

    local enabled_state active_state
    enabled_state="$(systemctl is-enabled "$svc" 2>/dev/null || true)"
    active_state="$(systemctl is-active "$svc" 2>/dev/null || true)"

    if [[ "$enabled_state" == "enabled" ]]; then
        ok "Service enabled: $svc"
    else
        warn "Service not enabled: $svc ($enabled_state)"
    fi

    if [[ "$active_state" == "active" ]]; then
        ok "Service active: $svc"
    else
        warn "Service not active: $svc ($active_state)"
    fi
}

echo "== BOOTC NVIDIA Hybrid Diagnostics =="

echo "-- Package checks --"
for pkg in \
    akmod-nvidia \
    xorg-x11-drv-nvidia \
    xorg-x11-drv-nvidia-cuda \
    xorg-x11-drv-nvidia-power \
    nvidia-persistenced \
    switcheroo-control; do
    check_rpm "$pkg"
done

echo "-- Module config checks --"
if [[ -f /etc/modprobe.d/nvidia-pm.conf ]] && grep -q '^options nvidia_drm modeset=1' /etc/modprobe.d/nvidia-pm.conf; then
    ok "nvidia_drm modeset=1 configured"
else
    fail "Missing nvidia_drm modeset=1 in /etc/modprobe.d/nvidia-pm.conf"
fi

if [[ -f /etc/modprobe.d/nvidia-pm.conf ]] && grep -q '^options nvidia_drm fbdev=1' /etc/modprobe.d/nvidia-pm.conf; then
    ok "nvidia_drm fbdev=1 configured"
else
    fail "Missing nvidia_drm fbdev=1 in /etc/modprobe.d/nvidia-pm.conf"
fi

if lsmod | grep -q '^nouveau'; then
    fail "nouveau kernel module is loaded"
else
    ok "nouveau kernel module is not loaded"
fi

if lsmod | grep -q '^nvidia'; then
    ok "nvidia kernel module is loaded"
else
    fail "nvidia kernel module is not loaded"
fi

if lsmod | grep -q '^nvidia_drm'; then
    ok "nvidia_drm kernel module is loaded"
else
    warn "nvidia_drm kernel module is not loaded"
fi

echo "-- Service checks --"
for svc in \
    switcheroo-control.service \
    nvidia-powerd.service \
    nvidia-persistenced.service \
    nvidia-suspend.service \
    nvidia-resume.service \
    nvidia-hibernate.service; do
    check_service_state "$svc"
done

echo "-- Runtime checks --"
if command -v nvidia-smi >/dev/null 2>&1; then
    if nvidia-smi >/tmp/nvidia-smi.out 2>/tmp/nvidia-smi.err; then
        ok "nvidia-smi command succeeded"
    else
        fail "nvidia-smi failed; stderr: $(tail -n 1 /tmp/nvidia-smi.err 2>/dev/null || echo unknown)"
    fi
else
    fail "nvidia-smi command not found"
fi

NVIDIA_PCI_RAW="$(lspci -Dnn 2>/dev/null | awk '/NVIDIA/{print $1; exit}')"
if [[ -n "${NVIDIA_PCI_RAW}" ]]; then
    RUNTIME_STATUS_FILE="/sys/bus/pci/devices/${NVIDIA_PCI_RAW}/power/runtime_status"
    if [[ -f "$RUNTIME_STATUS_FILE" ]]; then
        RUNTIME_STATUS="$(cat "$RUNTIME_STATUS_FILE" 2>/dev/null || true)"
        if [[ "$RUNTIME_STATUS" == "active" ]]; then
            ok "NVIDIA PCI runtime status is active (${NVIDIA_PCI_RAW})"
        else
            warn "NVIDIA PCI runtime status is ${RUNTIME_STATUS:-unknown} (${NVIDIA_PCI_RAW})"
        fi
    else
        warn "Runtime status file missing for NVIDIA PCI device: ${NVIDIA_PCI_RAW}"
    fi
else
    fail "No NVIDIA PCI device found via lspci"
fi

echo
echo "Summary: PASS=$PASS WARN=$WARN FAIL=$FAIL"

if (( STRICT == 1 && FAIL > 0 )); then
    exit 1
fi
exit 0
EOF
RUN chmod +x /usr/local/bin/bootc/nvidia-hybrid-diagnostics.sh

# Systemd service: distribute k3s kubeconfig to all local users after k3s server starts.
# /etc/rancher/k3s/k3s.yaml is only created on the first successful 'k3s server' run,
# so this cannot be done at post-install time — it must happen at runtime.
RUN mkdir -p /usr/local/bin/bootc && \
    cat > /usr/local/bin/bootc/k3s-distribute-kubeconfig.sh <<'KUBEEOF'
#!/bin/bash
# Distribute /etc/rancher/k3s/k3s.yaml to every local user's ~/.kube/config.
# Called by k3s-kubeconfig-distribute.service after k3s.service activates.
set -euo pipefail

KUBECONFIG_SRC="/etc/rancher/k3s/k3s.yaml"

# Wait up to 60 s for k3s to write its kubeconfig
for i in $(seq 1 60); do
    [ -f "$KUBECONFIG_SRC" ] && break
    sleep 1
done

if [ ! -f "$KUBECONFIG_SRC" ]; then
    echo "k3s kubeconfig not found after 60 s: $KUBECONFIG_SRC"
    exit 1
fi

while IFS=: read -r username _ uid _ _ homedir shell; do
    # Skip system accounts (UID < 1000) and shells that indicate non-login users
    (( uid >= 1000 )) || continue
    [[ "$shell" =~ (nologin|false|sync|halt|shutdown) ]] && continue
    [[ "$homedir" =~ ^/ ]] || continue
    [ -d "$homedir" ] || continue

    mkdir -p "$homedir/.kube"

    # If post-install already linked ~/.kube/config to the k3s source file,
    # copying would be a same-file operation and fail under set -e.
    if [ -L "$homedir/.kube/config" ] && [ "$(readlink -f "$homedir/.kube/config" 2>/dev/null || true)" = "$KUBECONFIG_SRC" ]; then
        chown "${username}:${username}" "$homedir/.kube"
        chmod 700 "$homedir/.kube"
        echo "  k3s kubeconfig already linked for $username"
        continue
    fi

    cp "$KUBECONFIG_SRC" "$homedir/.kube/config"
    chown "${username}:${username}" "$homedir/.kube/config"
    chown "${username}:${username}" "$homedir/.kube"
    chmod 700 "$homedir/.kube"
    chmod 600 "$homedir/.kube/config"
    echo "  k3s kubeconfig → $homedir/.kube/config"
done < /etc/passwd

echo "k3s kubeconfig distribution complete"
KUBEEOF
RUN chmod +x /usr/local/bin/bootc/k3s-distribute-kubeconfig.sh

# k3s pre-start script — extracted from the unit file to avoid systemd
# line-continuation + shell-escaping interactions that corrupt variable values.
# This script is also safe to call manually before 'sudo k3s server'.
RUN cat > /usr/local/bin/bootc/k3s-pre-start.sh <<'PREEOF'
#!/bin/bash
# Pre-start helper for k3s.service in air-gapped environments.
# Each step is best-effort: failures are logged but never abort the script.
# Do NOT add set -e — every command must be allowed to fail gracefully.

log() { echo "k3s-pre: $*"; }

# 1. Kernel modules required by flannel/CNI and the dummy network interface.
modprobe overlay      2>/dev/null || log "WARNING: overlay module unavailable"
modprobe br_netfilter 2>/dev/null || log "WARNING: br_netfilter module unavailable"
modprobe dummy        2>/dev/null || log "WARNING: dummy module unavailable (may be built-in)"

# 2. Populate air-gap image directory from staged artifacts (idempotent).
AIRGAP_SRC=/usr/share/k3s
AIRGAP_DST=/var/lib/rancher/k3s/agent/images
if ls "${AIRGAP_SRC}"/k3s-airgap-images-*.tar.zst >/dev/null 2>&1; then
    mkdir -p "${AIRGAP_DST}"
    for f in "${AIRGAP_SRC}"/k3s-airgap-images-*.tar.zst; do
        dst="${AIRGAP_DST}/$(basename "$f")"
        if [ ! -f "$dst" ]; then
            cp "$f" "$dst" && log "staged $(basename "$f")"
        fi
    done
fi

# 3. Detect the primary non-loopback IPv4 address (scope global = excludes lo).
#    Wait up to 30 s for NetworkManager to configure interfaces.
NODE_IP=""
for i in $(seq 1 30); do
    NODE_IP=$(ip -4 addr show scope global 2>/dev/null \
              | awk '/inet /{print $2}' \
              | cut -d/ -f1 \
              | head -1)
    [ -n "$NODE_IP" ] && break
    sleep 1
done

# 4. If still no IP (no LAN cable, fully isolated), create a kernel dummy
#    interface with a stable private address so k3s has a valid node IP.
#    Using 'scope global' in step 3 already excludes 127.x, so this only
#    runs when truly no routable interface is configured.
if [ -z "$NODE_IP" ]; then
    DUMMY_IF=k3s-node
    DUMMY_IP=10.0.2.1
    if ! ip link show "${DUMMY_IF}" >/dev/null 2>&1; then
        ip link add "${DUMMY_IF}" type dummy  2>/dev/null || log "WARNING: could not create dummy interface"
        ip link set "${DUMMY_IF}" up          2>/dev/null || true
        ip addr add "${DUMMY_IP}/24" dev "${DUMMY_IF}" 2>/dev/null || true
        log "created dummy interface ${DUMMY_IF} (${DUMMY_IP}/24)"
    fi
    NODE_IP="${DUMMY_IP}"
    log "no physical LAN IP found — using dummy node IP ${NODE_IP}"
fi

# 5. Ensure /proc/net/route has a default entry.
#    k3s falls back to reading /proc/net/route even when node-ip is configured
#    in some versions.  Route via the interface that owns NODE_IP; metric 65535
#    so any real gateway always wins.
#    Use 'scope global' to find the correct interface (not loopback).
if ! ip route show default 2>/dev/null | grep -q '^default'; then
    NODE_IF=$(ip -4 addr show scope global 2>/dev/null \
              | awk '/inet /{print $NF; exit}')
    NODE_IF="${NODE_IF:-lo}"
    ip route add default dev "${NODE_IF}" metric 65535 2>/dev/null || true
    log "dummy default route added via ${NODE_IF} (metric 65535)"
fi

# 6. Write node-ip into the MAIN k3s config (/etc/rancher/k3s/config.yaml).
#    This is read by ALL k3s versions.  The config.yaml.d drop-in is also
#    written for k3s v1.26+ which supports drop-in directories — belt and
#    suspenders so the correct IP is picked up regardless of k3s version.
MAIN_CFG=/etc/rancher/k3s/config.yaml
if grep -q '^node-ip:' "${MAIN_CFG}" 2>/dev/null; then
    # Replace existing node-ip line in-place
    sed -i "s|^node-ip:.*|node-ip: \"${NODE_IP}\"|" "${MAIN_CFG}"
else
    # Append to config (file was created at image build time with other settings)
    printf 'node-ip: "%s"\n' "${NODE_IP}" >> "${MAIN_CFG}"
fi

# Also write drop-in for k3s v1.26+ (drop-ins override main config)
mkdir -p /etc/rancher/k3s/config.yaml.d
printf 'node-ip: "%s"\n' "${NODE_IP}" \
    > /etc/rancher/k3s/config.yaml.d/10-node-ip.yaml

log "node-ip set to ${NODE_IP} in ${MAIN_CFG} and config.yaml.d/10-node-ip.yaml"
PREEOF
RUN chmod +x /usr/local/bin/bootc/k3s-pre-start.sh

# Install k3s.service — runs "k3s server" as root at startup.
# ExecStartPre calls the dedicated pre-start script so there are no
# quoting/escaping issues from inline shell-in-unit-file constructs.
RUN mkdir -p /usr/lib/systemd/system && \
    cat > /usr/lib/systemd/system/k3s.service <<'UNITEOF'
[Unit]
Description=Lightweight Kubernetes (k3s server)
Documentation=https://k3s.io
# Soft dependency: k3s starts as soon as basic networking is up (network.target).
# network-online.target is NOT used here — in air-gapped environments it may
# stall indefinitely waiting for an upstream connection that never arrives.
# IMPORTANT: k3s must wait for ntpdate-sync.service to complete, ensuring system
# time is synchronized before certificates are generated. This prevents k3s
# certificates from being issued with future timestamps due to skewed hardware clocks.
Wants=network-online.target
After=network.target systemd-modules-load.service ntpdate-sync.service

[Service]
Type=notify
ExecStartPre=/usr/local/bin/bootc/k3s-pre-start.sh
ExecStart=/usr/local/bin/k3s server
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
UNITEOF

# Install the systemd unit
RUN mkdir -p /usr/lib/systemd/system && \
    cat > /usr/lib/systemd/system/k3s-kubeconfig-distribute.service <<'UNITEOF'
[Unit]
Description=Distribute k3s kubeconfig to local users
Documentation=man:k3s(1)
After=k3s.service
BindsTo=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/bootc/k3s-distribute-kubeconfig.sh

[Install]
WantedBy=k3s.service
UNITEOF

# k3s networking prerequisites — sysctl settings required by k3s / flannel
# Applied at boot by systemd-sysctl.service before k3s starts.
RUN mkdir -p /etc/sysctl.d && \
    cat > /etc/sysctl.d/99-k3s.conf <<'EOF'
# Required by k3s/flannel for pod-to-pod and pod-to-service routing
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
# Allow bridge traffic to pass through iptables (needed by CNI / flannel)
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
# Increase conntrack table size for cluster workloads
net.netfilter.nf_conntrack_max = 131072
EOF

# k3s route-setup service — adds pod CIDR and service CIDR routes for the
# flannel interface so they survive in an air-gapped environment where no
# cloud provider or DHCP helper re-publishes them.
# Default k3s CIDRs: pods 10.42.0.0/16, services 10.96.0.0/12.
# Runs after k3s.service is active; idempotent (ip route add ... 2>/dev/null || true).
RUN mkdir -p /usr/lib/systemd/system && \
    cat > /usr/lib/systemd/system/k3s-route-setup.service <<'UNITEOF'
[Unit]
Description=Configure IP routes for k3s air-gapped networking
Documentation=https://docs.k3s.io/installation/network-options
After=k3s.service network-online.target
Wants=network-online.target
BindsTo=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Wait until the flannel.1 interface appears (k3s creates it on first run)
ExecStartPre=/bin/sh -c ' \
    for i in $(seq 1 60); do \
        ip link show flannel.1 >/dev/null 2>&1 && exit 0; \
        sleep 1; \
    done; \
    echo "WARNING: flannel.1 interface not found after 60 s"; exit 0'
# Ensure pod-network and service-network routes exist via the flannel interface
ExecStart=/bin/sh -c ' \
    FLANNEL_IF=flannel.1; \
    POD_CIDR=10.42.0.0/16; \
    SVC_CIDR=10.96.0.0/12; \
    if ip link show "$FLANNEL_IF" >/dev/null 2>&1; then \
        ip route add "$POD_CIDR" dev "$FLANNEL_IF" 2>/dev/null || true; \
        ip route add "$SVC_CIDR" dev "$FLANNEL_IF" 2>/dev/null || true; \
        echo "k3s routes ensured: $POD_CIDR  $SVC_CIDR via $FLANNEL_IF"; \
    else \
        echo "flannel.1 not present — skipping route setup"; \
    fi'

[Install]
WantedBy=k3s.service
UNITEOF

# Enable services (set default in image; post-install script re-runs for explicit confirmation)
# Mask systemd-remount-fs.service: in a bootc/ostree image the root filesystem is
# a composefs overlay managed by ostree. systemd-remount-fs tries to re-apply
# /etc/fstab options to / and /etc at boot — but bootc images ship without an
# /etc/fstab and the composefs root cannot be remounted, causing a guaranteed
# failure that pollutes the journal and shows in 'systemctl --failed'.
RUN systemctl enable gdm || true && \
    systemctl enable xrdp || true && \
    if systemctl list-unit-files | grep -q '^bootc-fetch-apply-updates\.timer'; then systemctl enable bootc-fetch-apply-updates.timer || true; fi && \
    for UNIT in nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service nvidia-powerd.service switcheroo-control.service; do if systemctl list-unit-files | grep -q "^${UNIT}"; then systemctl enable "$UNIT" || true; fi; done && \
    systemctl enable k3s.service || true && \
    systemctl enable k3s-kubeconfig-distribute.service || true && \
    systemctl enable k3s-route-setup.service || true && \
    systemctl mask systemd-remount-fs.service || true && \
    systemctl set-default graphical.target || true

# Create README in users' home
RUN cat > /etc/skel/README.txt <<'EOF'
BOOTC Bootc Workstation — Quick Start & Post-Boot Tasks
=====================================================

This system image ships with helper scripts and pre-cached artifacts under
`/usr/local/bin/bootc/` and caches under `/opt` so that air-gapped installs
work out of the box.

Key scripts (location: `/usr/local/bin/bootc/`)
- `bootc-post-install.sh` — consolidated admin post-install tasks. Run as root.
        - Usage highlights: `sudo /usr/local/bin/bootc/bootc-post-install.sh [options] [users...]`
        - Supported flags:
            - `--bootc-user NAME`  : username to create during the bootc user step
            - `--bootc-password-file FILE` : read password from file (preferred — avoids exposing credentials in ps/cmdline)
            - `--bootc-password PASS` : password to set during the bootc user step (insecure: visible in ps; use --bootc-password-file)
            - `--skip-extensions` : do not install VS Code extensions
            - `--skip-readme`     : do not copy README to user desktops
            - `--skip-services`   : skip enabling GUI services (display manager/xrdp/graphical.target)
            - `--skip-nvidia`     : skip NVIDIA verification checks
            - `--run-nvidia-diagnostics` : run the NVIDIA hybrid diagnostics report
            - `--skip-docker`     : skip adding users to `docker` group
            - `--skip-podman`     : skip podman socket enablement steps
            - `--skip-create-user`: skip creating the configured bootc user
            - `--only-steps LIST` : run only the comma-separated steps (create_user,extensions,readme,services,nvidia,nvidia-diagnostics,docker,podman)
        - Examples:
            - Run all admin setup: `sudo /usr/local/bin/bootc/bootc-post-install.sh`
            - Create a specific user non-interactively: `printf 'mypassword' > /root/.bootc-pw && chmod 600 /root/.bootc-pw && sudo /usr/local/bin/bootc/bootc-post-install.sh --bootc-user alice --bootc-password-file /root/.bootc-pw && rm /root/.bootc-pw`
            - Run only user creation and services: `sudo /usr/local/bin/bootc/bootc-post-install.sh --only-steps create_user,services`
            - Run only NVIDIA diagnostics: `sudo /usr/local/bin/bootc/bootc-post-install.sh --only-steps nvidia-diagnostics`
            - Install extensions for a specific user: `sudo /usr/local/bin/bootc/bootc-post-install.sh alice`

- `install-js-frameworks.sh` — installs common JS frameworks globally (optional).

Where cached/offline files are placed
- OpenShift/Kubernetes tools: `/usr/local/bin/bootc/oc`, `/usr/local/bin/bootc/kubectl`
- Pre-downloaded RPMs: staged under `/opt/offline/` and installed during build

Post-boot recommended steps (first boot)
1. Ensure network is configured (NetworkManager GUI or `nmcli`).
2. As root, run the consolidated post-install to complete admin setup:
     `sudo /usr/local/bin/bootc/bootc-post-install.sh`
     - Use `--skip-...` flags to disable parts you don't want to run.
     - To only perform specific actions use `--only-steps`.
3. Reboot if `bootc-post-install.sh` indicates services or kernel modules need it.

Per-user tasks
- After first login, users who need the Podman user socket can enable it locally:
    `systemctl --user enable --now podman.socket`
    (If lingering is desired for the account, `sudo loginctl enable-linger <user>`.)

Verifications
- NVIDIA: run `nvidia-smi` after reboot to confirm driver and kernel module functionality.
- VS Code extensions: run `code --list-extensions` as the user to confirm installed extensions.

Troubleshooting notes
- Many build-time warnings are expected in container-built images (e.g. pip running as root,
    systemd messages while running in a build container). The post-install script performs
    the runtime steps that require an installed system.
- If podman socket setup fails in the post-install script, run the user `systemctl --user`
    commands after the user first logs in.

Useful commands
- Run post-install (admin): `sudo /usr/local/bin/bootc/bootc-post-install.sh`
- Install JS frameworks (admin): `sudo /usr/local/bin/bootc/install-js-frameworks.sh`
- Check OpenShift tools: `oc version && kubectl version`

EOF

# Bootc configuration
RUN echo 'BOOTC Bootc' > /etc/hostname && \
    (grep -q "\bBOOTC Bootc\b" /etc/hosts || echo "127.0.1.1    BOOTC Bootc" >> /etc/hosts)

# Final cleanup
RUN dnf -y clean all && rm -rf /var/cache/dnf /tmp/* /var/tmp/*