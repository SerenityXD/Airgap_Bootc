# syntax=docker/dockerfile:1.4
# Bootc system image for air-gapped desktop workstation
# Includes: GNOME desktop, dev tools, NVIDIA/CUDA, ML, multimedia, Docker Desktop, VS Code

FROM quay.io/fedora/fedora-bootc:44

# Use bash with pipefail for safer RUN blocks (this Containerfile relies on bash features).
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Build-time optimization flags (optional packages are included unless excluded)
ARG EXCLUDE_BLENDER=no
ARG EXCLUDE_DOCKER_DESKTOP=no
ARG EXCLUDE_GIMP_KRITA=no
ARG EXCLUDE_RATIONS=no
ARG EXCLUDE_CUDA_TOOLKIT=no

# System metadata
LABEL name="BOOTC Bootc Workstation"
LABEL version="1.0"
LABEL description="Air-gapped desktop workstation with dev tools, NVIDIA, ML, multimedia"

# Set timezone (change Asia/Singapore to your preferred timezone)
RUN ln -sf /usr/share/zoneinfo/Asia/Singapore /etc/localtime && \
    echo "Asia/Singapore" > /etc/timezone

# Configure NTP time servers
RUN mkdir -p /etc/chrony.d && \
    echo "# Custom NTP servers" > /etc/chrony.d/custom-servers.conf && \
    echo "server time.windows.com iburst" >> /etc/chrony.d/custom-servers.conf && \
    echo "server time.nist.gov iburst" >> /etc/chrony.d/custom-servers.conf && \
    echo "server pool.ntp.org iburst" >> /etc/chrony.d/custom-servers.conf

# Run an initial ntpdate sync before chronyd takes over continuous timekeeping.
RUN mkdir -p /usr/local/bin/bootc /usr/lib/systemd/system && \
    printf '%s\n' \
        '#!/usr/bin/env bash' \
        'set -euo pipefail' \
        '' \
        'mapfile -t ntp_servers < <(awk '\''$1 == "server" { print $2 }'\'' /etc/chrony.d/custom-servers.conf 2>/dev/null)' \
        '' \
        'if [ ${#ntp_servers[@]} -eq 0 ]; then' \
        '    ntp_servers=(time.windows.com time.nist.gov pool.ntp.org)' \
        'fi' \
        '' \
        'exec /usr/sbin/ntpdate -ub "${ntp_servers[@]}"' \
        > /usr/local/bin/bootc/ntpdate-sync.sh && \
    chmod 0755 /usr/local/bin/bootc/ntpdate-sync.sh && \
    printf '%s\n' \
        '[Unit]' \
        'Description=Initial NTP sync before chronyd' \
        'Wants=network-online.target' \
        'After=network-online.target' \
        'Before=chronyd.service' \
        'ConditionPathExists=/usr/sbin/ntpdate' \
        '' \
        '[Service]' \
        'Type=oneshot' \
        'ExecStart=/usr/local/bin/bootc/ntpdate-sync.sh' \
        'RemainAfterExit=yes' \
        '' \
        '[Install]' \
        'WantedBy=multi-user.target' \
        > /usr/lib/systemd/system/ntpdate-sync.service

# Trust the bundled enterprise CA
COPY ca-bundle.crt /etc/pki/ca-trust/source/anchors/bootc-local-ca.crt
RUN update-ca-trust

# Minimize dnf footprint and locales
RUN sed -i '/^tsflags/ d' /etc/dnf/dnf.conf && echo 'tsflags=nodocs' >> /etc/dnf/dnf.conf && \
    dnf -y install glibc-minimal-langpack langpacks-en || true && \
    dnf -y remove glibc-all-langpacks || true && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Install GNOME Desktop Environment and base system
RUN echo "Installing GNOME desktop environment" && \
    dnf -y --setopt=install_weak_deps=False install \
    gnome-shell gnome-session gdm gnome-control-center gnome-terminal gnome-text-editor nautilus gnome-system-monitor gnome-disk-utility gnome-tweaks evince eog file-roller gnome-connections gnome-shell-extension-appindicator gvfs-fuse \
    # GNOME Nautilus context menu and extensions
    nautilus-open-terminal sushi \
    # Display server
    xorg-x11-server-Xorg \
    mesa-dri-drivers \
    # Additional tools
    make gcc gcc-c++ cmake automake autoconf \
    python3-pip python3-devel \
    git fastfetch \
    network-manager-applet \
    kernel-devel kernel-modules-extra \
    power-profiles-daemon \
    ntpdate \
    traceroute \
    # Audio stack (Intel firmware + PipeWire ALSA/PulseAudio bridges)
    intel-audio-firmware \
    alsa-sof-firmware \
    alsa-firmware \
    pipewire-alsa \
    pipewire-pulseaudio \
    wireplumber \
    alsa-utils \
    # Container tools
    slirp4netns conntrack-tools bridge-utils fuse-overlayfs podman \
    # Remote desktop
    xrdp xorgxrdp \
    # Windows network discovery and file sharing
    samba samba-client samba-common cifs-utils \
    avahi avahi-tools nss-mdns \
    wsdd \
    # Desktop SMB/Windows network browsing support
    gvfs-smb \
    # Additional archive tools
    ark unrar \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Enable network discovery services and time synchronization
RUN systemctl enable ntpdate-sync.service && \
    systemctl enable chronyd.service && \
    systemctl enable avahi-daemon.service && \
    systemctl enable wsdd.service && \
    systemctl enable smb.service && \
    systemctl enable nmb.service

# Configure Samba for Windows network discovery
RUN mkdir -p /etc/samba && \
    cat > /etc/samba/smb.conf <<'EOF'
[global]
   workgroup = WORKGROUP
   server string = BOOTC Bootc Workstation
   security = user
   map to guest = Never
   dns proxy = no
   
   # Network discovery settings (server side - be visible to Windows)
   local master = yes
   preferred master = yes
   os level = 35
   
   # Client browsing settings (discover Windows machines)
   name resolve order = bcast host lmhosts wins
   client use spnego = yes
   client ntlmv2 auth = yes
   
   # Enable WSD/LLMNR for Windows 10+ discovery
   multicast dns register = yes
   
   # Logging
   log file = /var/log/samba/log.%m
   max log size = 50
   
   # Sync Linux password changes into the Samba password database
   unix password sync = yes
   passwd program = /usr/bin/passwd %u
   pam password change = yes

   # Performance and compatibility
   server min protocol = SMB2
   client min protocol = SMB2
   
   # Allow browsing of Windows workgroups and computers
   remote browse sync = yes
   remote announce = 255.255.255.255/WORKGROUP
   
   # User shares (allow regular users to create and manage shares)
   usershare path = /var/lib/samba/usershares
   usershare max shares = 100
   usershare allow guests = no
   usershare owner only = yes
   
[homes]
   comment = User Home Directories
   browseable = yes
   read only = no
   writable = yes
   valid users = %S
   create mask = 0644
   directory mask = 0755
   path = %H

[UserHomes]
   comment = All User Home Directories
   path = /home
   browseable = yes
   read only = no
   guest ok = no
   create mask = 0644
   directory mask = 0755

# Example share (commented out - users can enable as needed)
# [Public]
#    comment = Public Share
#    path = /srv/samba/public
#    browseable = yes
#    read only = no
#    guest ok = yes
#    create mask = 0644
#    directory mask = 0755
EOF

# Set default home directory permissions to 0755 so Samba can serve cross-user access
# (individual user authentication via Samba still required; Linux FS governs reads)
RUN sed -i 's/^HOME_MODE.*/HOME_MODE 0755/' /etc/login.defs

# Set up usershares directory with proper permissions
RUN mkdir -p /var/lib/samba/usershares && \
    chmod 1770 /var/lib/samba/usershares && \
    chown root:root /var/lib/samba/usershares

# SELinux boolean service: samba_enable_home_dirs must be on for Samba to serve /home/*/
# The boolean lives in /var/lib/selinux/ (runtime-writable), so we use a oneshot unit
# that runs before smb.service on every boot and sets it persistently.
RUN mkdir -p /usr/lib/systemd/system && \
    cat > /usr/lib/systemd/system/samba-selinux-setup.service <<'SEEOF'
[Unit]
Description=Set SELinux booleans required for Samba home-directory sharing
DefaultDependencies=no
Before=smb.service nmb.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/setsebool -P samba_enable_home_dirs 1

[Install]
WantedBy=multi-user.target
SEEOF
RUN systemctl enable samba-selinux-setup.service

# Create Avahi service file for SMB/CIFS advertisement
RUN mkdir -p /etc/avahi/services && \
    cat > /etc/avahi/services/smb.service <<'EOF'
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=LinuxWorkstation</txt-record>
  </service>
</service-group>
EOF

# Install multimedia and creator tools
RUN dnf -y --setopt=install_weak_deps=False install \
    # Office and productivity
    libreoffice \
    # GIS
    qgis python3-qgis \
    # Web browsers
    firefox liberation-fonts \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Install offline wallpapers. Also register them and set a default via dconf for GNOME.
RUN --mount=type=bind,source=offline-repo/wallpapers,target=/tmp/offline/wallpapers,readonly \
    mkdir -p /usr/share/backgrounds/bootc && \
    mapfile -t WALLPAPER_FILES < <(find /tmp/offline/wallpapers -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) | sort) && \
    if [ ${#WALLPAPER_FILES[@]} -eq 0 ]; then \
        echo "No offline wallpapers found in /tmp/offline/wallpapers; keeping distro default"; \
    else \
        echo "Installing ${#WALLPAPER_FILES[@]} offline wallpapers"; \
        mkdir -p /usr/share/gnome-background-properties /etc/dconf/profile /etc/dconf/db/local.d; \
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">' '<wallpapers>' > /usr/share/gnome-background-properties/bootc-wallpapers.xml; \
        default_wallpaper=''; \
        idx=0; \
        for src in "${WALLPAPER_FILES[@]}"; do \
            idx=$((idx + 1)); \
            base_name=$(basename "$src"); \
            dest="/usr/share/backgrounds/bootc/$(printf '%03d' "$idx")-${base_name}"; \
            install -m 0644 "$src" "$dest"; \
            [ -z "$default_wallpaper" ] && default_wallpaper="$dest"; \
            printf '%s\n' \
                '  <wallpaper deleted="false">' \
                "    <name>${base_name}</name>" \
                "    <filename>${dest}</filename>" \
                '    <options>zoom</options>' \
                '    <shade_type>solid</shade_type>' \
                '    <pcolor>#000000</pcolor>' \
                '    <scolor>#000000</scolor>' \
                '  </wallpaper>' >> /usr/share/gnome-background-properties/bootc-wallpapers.xml; \
        done; \
        printf '%s\n' '</wallpapers>' >> /usr/share/gnome-background-properties/bootc-wallpapers.xml; \
        printf '%s\n' 'user-db:user' 'system-db:local' > /etc/dconf/profile/user; \
        printf '%s\n' \
            '[org/gnome/desktop/background]' \
            "picture-uri='file://${default_wallpaper}'" \
            "picture-uri-dark='file://${default_wallpaper}'" \
            "picture-options='zoom'" > /etc/dconf/db/local.d/00-bootc-background; \
        dconf update; \
        echo "Default wallpaper: $default_wallpaper"; \
    fi

# ---------------------------------------------------------------------------
# Screen-watermark GNOME Shell extension
# Displays a persistent tiled diagonal overlay: username · hostname · login time
# ---------------------------------------------------------------------------
# Enable the extension system-wide via two complementary mechanisms:
#
#  1. dconf system-db default  — applies when the user has NO existing
#     enabled-extensions value (e.g. brand-new accounts).
#
#  2. XDG autostart entry      — runs at every GNOME session start and calls
#     `gnome-extensions enable` which *appends* to the user's extension list.
#     This is the reliable path for users whose dconf user-db already has an
#     enabled-extensions entry (overrides the system-db default).
RUN --mount=type=bind,source=gnome-extensions/screen-watermark@bootc.local,target=/tmp/gnome-ext/screen-watermark@bootc.local,readonly \
    mkdir -p /usr/share/gnome-shell/extensions && \
    cp -a /tmp/gnome-ext/screen-watermark@bootc.local /usr/share/gnome-shell/extensions/screen-watermark@bootc.local && \
    mkdir -p /etc/dconf/db/local.d /etc/xdg/autostart && \
    printf '%s\n' \
        '[org/gnome/shell]' \
        "enabled-extensions=['screen-watermark@bootc.local']" \
        > /etc/dconf/db/local.d/01-bootc-extensions && \
    dconf update && \
    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        'Name=BOOTC Screen Watermark' \
        'Comment=Ensures the persistent screen watermark extension is active' \
        'Exec=/bin/bash -c "sleep 4 && gnome-extensions enable screen-watermark@bootc.local"' \
        'NoDisplay=true' \
        'X-GNOME-Autostart-enabled=true' \
        'X-GNOME-Autostart-Delay=0' \
        > /etc/xdg/autostart/bootc-watermark-enable.desktop && \
    echo "✓ GNOME extension setup complete (unconditional - always installed)"

# Install rations (portablemc Minecraft launcher + offline game files) - OPTIONAL
# To exclude, use: podman build --build-arg EXCLUDE_RATIONS=yes
# rations.zip contains pre-seeded .minecraft files; portablemc is the CLI launcher binary.
COPY offline-repo/rations/ /opt/rations/
RUN if [ "$EXCLUDE_RATIONS" != "yes" ]; then \
        echo "Installing portablemc dependencies..."; \
        dnf -y --setopt=install_weak_deps=False install \
            openssl-libs zlib unzip && \
        dnf -y clean all && rm -rf /var/cache/dnf; \
        echo "Installing portablemc binary..."; \
        install -m 0755 /opt/rations/portablemc /usr/local/bin/portablemc; \
        echo "Extracting rations.zip game files to /opt/rations/..."; \
        unzip -o /opt/rations/rations.zip -d /opt/rations/ && \
        rm -f /opt/rations/rations.zip && \
        rm -f /opt/rations/portablemc; \
        echo "Creating portablemc wrapper..."; \
        printf '%s\n' \
            '#!/usr/bin/env bash' \
            'exec /usr/local/bin/portablemc --main-dir /opt/rations "$@"' \
            > /usr/local/bin/minecraft && \
        chmod +x /usr/local/bin/minecraft; \
        echo "portablemc and rations installed successfully"; \
    else \
        echo "Rations (portablemc) skipped (set --build-arg EXCLUDE_RATIONS=yes to exclude)"; \
    fi

# Install Google Chrome (resolve dependencies via dnf instead of raw rpm -i)
# Import Google's signing key before installing so dnf can verify the RPM signature.
RUN dnf -y --setopt=install_weak_deps=False install wget xdg-utils && \
    rpm --import https://dl.google.com/linux/linux_signing_key.pub && \
    curl --fail --show-error --location --retry 5 --retry-delay 3 --retry-connrefused \
    https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm \
    -o /tmp/google-chrome.rpm && \
    dnf -y install /tmp/google-chrome.rpm && \
    rm -f /tmp/google-chrome.rpm && \
    dnf -y clean all && rm -rf /var/cache/dnf

