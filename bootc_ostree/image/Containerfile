# Create consolidated post-install script
RUN cat > /usr/local/bin/scvu/scvu-post-install.sh <<'EOF'
#!/bin/bash
set -euo pipefail

CACHE_ROOT="/opt/python-wheels"
README_SRC="/usr/local/bin/scvu/SCVU-README.md"

usage() {
cat <<'USAGE'
Usage: scvu-post-install.sh [options] [user...]
  --skip-extensions  Skip VS Code extensions
  --skip-readme      Skip copying README to user desktops
  --skip-services    Skip enabling GUI services (sddm/xrdp/graphical target)
  --skip-nvidia      Skip NVIDIA initramfs refresh
  --skip-docker      Skip adding users to docker group
  --skip-podman      Skip podman user socket enable
  --skip-create-user Skip creating AIBUser
  --only-steps LIST  Run only selected steps (comma-separated). Choices: create-user,extensions,readme,services,nvidia,docker,podman
  -h, --help         Show this help

Users (optional): if provided, VS Code extensions install only for those users. Defaults to all local users.

Note: Python wheels installed system-wide during build for all users
USAGE
}

if [[ $EUID -ne 0 ]]; then
    echo "Error: This script must be run as root (use: sudo /usr/local/bin/scvu/scvu-post-install.sh)"
    exit 1
fi

RUN_BASE=1
RUN_EXT=1
RUN_README=1
RUN_SERVICES=1
RUN_NVIDIA_STEP=1
RUN_DOCKER_GROUP=1
RUN_PODMAN=1
RUN_CREATE_USER=1
ONLY_MODE=0

disable_all_base_steps() {
    RUN_EXT=0
    RUN_README=0
    RUN_SERVICES=0
    RUN_NVIDIA_STEP=0
    RUN_DOCKER_GROUP=0
    RUN_PODMAN=0
    RUN_CREATE_USER=0
}

normalize_step() {
    local raw="${1,,}"
    raw="${raw//-/_}"
    case "$raw" in
        create_user|createuser|create_aibuser) echo "create_user" ;;
        extension|extensions) echo "extensions" ;;
        readme|desktop_readme|readme_desktop) echo "readme" ;;
        service|services) echo "services" ;;
        nvidia|gpu) echo "nvidia" ;;
        docker|docker_group) echo "docker" ;;
        podman|podman_socket) echo "podman" ;;
        *) echo "" ;;
    esac
}

select_only_steps() {
    local list="$1"
    [[ $ONLY_MODE -eq 0 ]] && disable_all_base_steps
    ONLY_MODE=1

    IFS=',' read -ra parts <<< "$list"
    for raw in "${parts[@]}"; do
        local step
        step=$(normalize_step "$raw")
        case "$step" in
            create_user) RUN_CREATE_USER=1 ;;
            extensions) RUN_EXT=1 ;;
            readme) RUN_README=1 ;;
            services) RUN_SERVICES=1 ;;
            nvidia) RUN_NVIDIA_STEP=1 ;;
            docker) RUN_DOCKER_GROUP=1 ;;
            podman) RUN_PODMAN=1 ;;
            "") echo "Unknown step: $raw (use: create-user, extensions, readme, services, nvidia, docker, podman)" ;;
        esac
    done
}

declare -a USER_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip-extensions|--no-extensions)
            RUN_EXT=0; shift ;;
        --skip-readme|--no-readme)
            RUN_README=0; shift ;;
        --skip-services|--no-services)
            RUN_SERVICES=0; shift ;;
        --skip-nvidia|--no-nvidia)
            RUN_NVIDIA_STEP=0; shift ;;
        --skip-docker|--no-docker|--skip-docker-group)
            RUN_DOCKER_GROUP=0; shift ;;
        --skip-podman|--no-podman)
            RUN_PODMAN=0; shift ;;
        --skip-create-user|--no-create-user)
            RUN_CREATE_USER=0; shift ;;
        --only-steps)
            [ $# -ge 2 ] || { echo "Missing value for $1"; exit 1; }
            select_only_steps "$2"; shift 2 ;;
        --only-steps=*)
            select_only_steps "${1#*=}"; shift ;;
        -h|--help)
            usage; exit 0 ;;
        *)
            USER_ARGS+=("$1"); shift ;;
    esac
done

echo "SCVU Post-Install: starting"
step=1
next_step() { echo "Step $step: $1"; step=$((step+1)); }

create_aibuser() {
    local AIB_USER="AIBUser"
    local AIB_HOME="/var/home/$AIB_USER"

    if getent passwd "$AIB_USER" >/dev/null 2>&1; then
        echo "  User $AIB_USER already exists, skipping creation"
        return 0
    fi

    echo "  Creating user $AIB_USER..."
    if useradd -m -s /bin/bash "$AIB_USER" 2>/dev/null; then
        echo "  User $AIB_USER created successfully"
        
        # Set default password
        echo -e "A!BUserA!BUser\nA!BUserA!BUser" | passwd "$AIB_USER" 2>/dev/null || true
        echo "  Password set for $AIB_USER"
        
        # Add AIBUser to docker group if docker group exists
        if getent group docker >/dev/null 2>&1; then
            usermod -aG docker "$AIB_USER" 2>/dev/null || true
            echo "  Added $AIB_USER to docker group"
        fi
        
        # Copy README to AIBUser desktop
        if [ -f "$README_SRC" ]; then
            mkdir -p "$AIB_HOME/Desktop"
            cp "$README_SRC" "$AIB_HOME/Desktop/SCVU-README.md"
            chown "$AIB_USER:$AIB_USER" "$AIB_HOME/Desktop/SCVU-README.md"
            echo "  Copied README to $AIB_USER Desktop"
        fi
    else
        echo "  Warning: failed to create user $AIB_USER"
        return 1
    fi
}

install_extensions_for_user() {
    local U="$1"
    [ -n "$U" ] || return 0

    local HOME_DIR
    HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
    [ -d "$HOME_DIR" ] || { echo "Home not found for $U"; return 0; }

    if ! command -v code >/dev/null 2>&1; then
        echo "VS Code not found; skipping for $U"
        return 0
    fi

    echo "Installing VS Code extensions for user $U..."
    mkdir -p "$HOME_DIR/.vscode/extensions"
    chown -R "$U":"$U" "$HOME_DIR/.vscode"

    for VSIX in /opt/vscode-extensions/*.vsix; do
        [ -f "$VSIX" ] || continue
        echo "  Installing $(basename "$VSIX")"
        sudo -u "$U" code --install-extension "$VSIX" --force 2>/dev/null || echo "  Warning: extension install failed, continuing"
    done
}

enable_podman_socket_for_user() {
    local U="$1"
    local USER_UID
    USER_UID=$(id -u "$U" 2>/dev/null) || return 0

    loginctl enable-linger "$U" >/dev/null 2>&1 || echo "  Note: could not enable linger for $U (requires systemd-logind)"

    if [ ! -d "/run/user/$USER_UID" ]; then
        mkdir -p "/run/user/$USER_UID"
        chown "$USER_UID":"$USER_UID" "/run/user/$USER_UID"
        chmod 700 "/run/user/$USER_UID"
    fi

    sudo -u "$U" XDG_RUNTIME_DIR="/run/user/$UID" systemctl --user enable --now podman.socket 2>/dev/null || \
        echo "  Note: Podman user socket setup failed for $U; run after login: systemctl --user enable --now podman.socket"
}

if (( RUN_BASE )); then
    next_step "Creating AIBUser..."
    if (( RUN_CREATE_USER )); then
        create_aibuser
    else
        echo "  Skipping AIBUser creation (disabled by flag)"
    fi

    next_step "Installing VS Code extensions..."
    if (( RUN_EXT )); then
        if [ ${#USER_ARGS[@]} -gt 0 ]; then
            echo "  For specified users: ${USER_ARGS[*]}"
            for U in "${USER_ARGS[@]}"; do
                install_extensions_for_user "$U"
            done
        else
            echo "  For all local users..."
            mapfile -t USERS < <(getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Found ${#USERS[@]} users: ${USERS[*]}"
            for U in "${USERS[@]}"; do
                install_extensions_for_user "$U"
            done
        fi
    else
        echo "  Skipping VS Code extensions (disabled by flag)"
    fi

    next_step "Copying README to user desktops..."
    if (( RUN_README )); then
        if [ -f "$README_SRC" ]; then
            mapfile -t USERS < <(getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Found ${#USERS[@]} users: ${USERS[*]}"
            for U in "${USERS[@]}"; do
                HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
                [ -d "$HOME_DIR" ] || continue
                mkdir -p "$HOME_DIR/Desktop"
                cp "$README_SRC" "$HOME_DIR/Desktop/SCVU-README.md"
                chown "$U":"$U" "$HOME_DIR/Desktop/SCVU-README.md"
                echo "  Copied to $U Desktop"
            done
        else
            echo "  README not found, skipping"
        fi
    else
        echo "  Skipping README copy (disabled by flag)"
    fi

    next_step "Enabling GUI services..."
    if (( RUN_SERVICES )); then
        systemctl enable sddm 2>/dev/null || echo "  Warning: SDDM enable failed"
        systemctl enable xrdp 2>/dev/null || echo "  Warning: XRDP enable failed"
        systemctl set-default graphical.target 2>/dev/null || echo "  Warning: graphical.target set failed"
    else
        echo "  Skipping GUI services enable (disabled by flag)"
    fi

    next_step "NVIDIA post-install..."
    if (( RUN_NVIDIA_STEP )); then
        if command -v nvidia-smi >/dev/null 2>&1; then
            echo "  NVIDIA detected; updating initramfs..."
            if command -v dracut >/dev/null 2>&1; then
                dracut -f 2>/dev/null || echo "  Warning: dracut update failed"
            else
                echo "  Warning: dracut not available, skipping initramfs update"
            fi
        else
            echo "  NVIDIA not detected, skipping"
        fi
    else
        echo "  Skipping NVIDIA post-install (disabled by flag)"
    fi

    next_step "Docker group setup..."
    if (( RUN_DOCKER_GROUP )); then
        getent group docker >/dev/null 2>&1 || groupadd -f docker || echo "  Warning: failed to create docker group"

        if getent group docker >/dev/null 2>&1; then
            mapfile -t USERS < <(getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
            echo "  Found ${#USERS[@]} users: ${USERS[*]}"
            for U in "${USERS[@]}"; do
                usermod -aG docker "$U" 2>/dev/null || true
                echo "  Added $U to docker group"
            done
        else
            echo "  Docker group not available, skipping"
        fi
    else
        echo "  Skipping docker group additions (disabled by flag)"
    fi

    next_step "Podman setup..."
    if (( RUN_PODMAN )); then
        mapfile -t USERS < <(getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
        echo "  Enabling Podman user socket for: ${USERS[*]}"
        for U in "${USERS[@]}"; do
            enable_podman_socket_for_user "$U"
        done
    else
        echo "  Skipping podman socket enable (disabled by flag)"
    fi
else
    echo "Error: all base steps disabled"
    exit 1
fi

echo ""
echo "SCVU Post-Install: complete (admin tasks only)"
echo "Note: Some services may require a reboot to take full effect"
echo "Python wheels are pre-installed system-wide. Use /usr/local/bin/scvu/install-python-wheels.sh to verify or add user packages"
EOF
RUN chmod +x /usr/local/bin/scvu/scvu-post-install.sh

RUN cat > /usr/local/bin/scvu/install-python-wheels.sh <<'EOF'
#!/bin/bash
set -euo pipefail

CACHE_ROOT="/opt/python-wheels"

usage() {
cat <<'USAGE'
Usage: install-python-wheels.sh [options]
  --py VERSION       Limit installation to a specific interpreter (repeatable). Examples: py310, python3.11
  --all              Install for all available Python versions (default)
  --user             Install to user site-packages (default: system-wide check)
  -h, --help         Show this help

This script installs pre-downloaded Python wheels from /opt/python-wheels/.
Python wheels are already installed system-wide for all users.
Use this script to reinstall or add user-specific packages.

Examples:
  install-python-wheels.sh                    # Check/verify all Python versions
  install-python-wheels.sh --py py310 --user  # Reinstall for Python 3.10 (user)
  install-python-wheels.sh --py py310 --py py311  # Check Python 3.10 and 3.11
USAGE
}

normalize_py() {
    case "$1" in
        python3.[0-9]*) echo "$1" ;;
        py39|3.9) echo "python3.9" ;;
        py310|3.10) echo "python3.10" ;;
        py311|3.11) echo "python3.11" ;;
        py312|3.12) echo "python3.12" ;;
        py313|3.13) echo "python3.13" ;;
        *) echo "" ;;
    esac
}

install_for_py() {
    local py_cmd="$1"
    local user_flag="$2"
    
    if ! command -v "$py_cmd" >/dev/null 2>&1; then
        echo "  Skipping $py_cmd (interpreter not installed)"
        return 0
    fi

    local short dest
    short=$("$py_cmd" -c 'import sys; print(f"py{sys.version_info.major}{sys.version_info.minor}")')
    dest="${CACHE_ROOT}/${short}"

    if [ ! -d "$dest" ]; then
        echo "  Skipping $py_cmd (no cache at $dest)"
        return 0
    fi

    shopt -s nullglob
    local wheels=("$dest"/*.whl)
    if [ ${#wheels[@]} -eq 0 ]; then
        echo "  Skipping $py_cmd (no wheels in $dest)"
        shopt -u nullglob
        return 0
    fi

    echo "  Checking ${#wheels[@]} packages for $py_cmd..."
    
    # Check if packages are already installed
    local install_args="--no-cache-dir --no-index --find-links $dest"
    if [ "$user_flag" = "true" ]; then
        install_args="$install_args --user"
        echo "  Installing to user site-packages..."
    else
        echo "  Verifying system installation (already installed during build)..."
    fi
    
    "$py_cmd" -m pip install $install_args "${wheels[@]}" 2>&1 | grep -v "already satisfied" || echo "  ✓ All packages available for $py_cmd"
    shopt -u nullglob
}

declare -a WHEEL_SELECTORS=()
USER_INSTALL="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --py|--python)
            [ $# -ge 2 ] || { echo "Missing value for $1"; exit 1; }
            WHEEL_SELECTORS+=("$2"); shift 2 ;;
        --py=*|--python=*)
            WHEEL_SELECTORS+=("${1#*=}"); shift ;;
        --all)
            WHEEL_SELECTORS=(); shift ;;
        --user)
            USER_INSTALL="true"; shift ;;
        -h|--help)
            usage; exit 0 ;;
        *)
            echo "Unknown option: $1"; usage; exit 1 ;;
    esac
done

if [ ! -d "$CACHE_ROOT" ]; then
    echo "Error: No python wheel cache found at $CACHE_ROOT"
    exit 1
fi

echo "SCVU Python Wheels: Python packages installed system-wide during build"
echo "Checking installation from $CACHE_ROOT..."

selectors=()
if [ ${#WHEEL_SELECTORS[@]} -gt 0 ]; then
    selectors=("${WHEEL_SELECTORS[@]}")
else
    selectors=(python3.9 python3.10 python3.11 python3.12 python3.13)
fi

echo "Checking interpreters: ${selectors[*]}"
any=0
for sel in "${selectors[@]}"; do
    py_cmd=$(normalize_py "$sel")
    if [ -z "$py_cmd" ]; then
        echo "Unknown Python selector: $sel (use python3.10 or py310)"
        continue
    fi
    install_for_py "$py_cmd" "$USER_INSTALL"
    any=1
done

if [ $any -eq 0 ]; then
    echo "No interpreters installed or selected."
    exit 1
fi

echo ""
echo "SCVU Python Wheels: verification complete"
EOF
RUN chmod +x /usr/local/bin/scvu/install-python-wheels.sh

# Enable services (set default in image; post-install script re-runs for explicit confirmation)
RUN systemctl enable sddm || true && \
    systemctl enable xrdp || true && \
    systemctl set-default graphical.target || true

# Create README in users' home
RUN cat > /etc/skel/README.txt <<'EOF'
Welcome to SCVU Bootc Workstation
==================================

Pre-installed tools:
- oc (OpenShift CLI) - available as: oc
- kubectl (Kubernetes CLI) - available as: kubectl
- crc (CodeReady Containers) - available as: crc (if pre-cached)

Post-install tasks:
1. Run consolidated post install (admin tasks): sudo /usr/local/bin/scvu/scvu-post-install.sh
    - Skip wheels: sudo /usr/local/bin/scvu/scvu-post-install.sh --no-wheels
    - Per-step skips: add --skip-extensions/--skip-readme/--skip-services/--skip-nvidia/--skip-docker/--skip-podman
    - Only selected steps: sudo /usr/local/bin/scvu/scvu-post-install.sh --only-steps extensions,readme,services,nvidia,docker,podman

2. Python wheels are pre-installed system-wide for all users
    - Verify installation: /usr/local/bin/scvu/install-python-wheels.sh
    - Add user packages: /usr/local/bin/scvu/install-python-wheels.sh --py py310 --user

3. Install JS frameworks: /usr/local/bin/scvu/install-js-frameworks.sh

Quick start:
- Check OpenShift tools: oc version && kubectl version
- SSH/RDP into the system from another machine (XRDP configured)
- Install Python wheels per-user when needed
EOF

# Bootc configuration
RUN echo 'SCVU Bootc' > /etc/hostname && \
    (grep -q "\bSCVU Bootc\b" /etc/hosts || echo "127.0.1.1    SCVU Bootc" >> /etc/hosts)

# Final cleanup
RUN dnf -y clean all && rm -rf /var/cache/dnf /tmp/* /var/tmp/*
