# Bootc system image for air-gapped KDE workstation
# Includes: KDE, dev tools, NVIDIA/CUDA, ML, multimedia, Docker Desktop, VS Code

FROM quay.io/fedora/fedora-bootc:43

# System metadata
LABEL name="SCVU Bootc Workstation"
LABEL version="1.0"
LABEL description="Air-gapped KDE workstation with dev tools, NVIDIA, ML, multimedia"

# Set timezone (change Asia/Singapore to your preferred timezone)
RUN ln -sf /usr/share/zoneinfo/Asia/Singapore /etc/localtime && \
    echo "Asia/Singapore" > /etc/timezone

# Configure NTP time servers
RUN mkdir -p /etc/chrony.d && \
    echo "# Custom NTP servers" > /etc/chrony.d/custom-servers.conf && \
    echo "server time.windows.com iburst" >> /etc/chrony.d/custom-servers.conf && \
    echo "server time.nist.gov iburst" >> /etc/chrony.d/custom-servers.conf && \
    echo "server pool.ntp.org iburst" >> /etc/chrony.d/custom-servers.conf

# Minimize dnf footprint and locales
RUN sed -i '/^tsflags/ d' /etc/dnf/dnf.conf && echo 'tsflags=nodocs' >> /etc/dnf/dnf.conf && \
    dnf -y install glibc-minimal-langpack langpacks-en || true && \
    dnf -y remove glibc-all-langpacks || true && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Install KDE Desktop and base system
RUN dnf -y install \
    # KDE Desktop (skip @core as it's already in base image)
    @kde-desktop-environment @kde-apps \
    sddm filelight \
    # Display server
    xorg-x11-server-Xorg \
    mesa-dri-drivers \
    # Additional tools
    make gcc gcc-c++ cmake automake autoconf \
    python3-pip python3-devel \
    git fastfetch \
    network-manager-applet \
    kernel-devel kernel-modules-extra \
    # Container tools
    slirp4netns conntrack-tools bridge-utils fuse-overlayfs podman \
    # Remote desktop
    xrdp xorgxrdp \
    # Windows network discovery and file sharing
    samba-client samba-common cifs-utils \
    avahi avahi-tools nss-mdns \
    wsdd \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Enable network discovery services
RUN systemctl enable avahi-daemon.service && \
    systemctl enable wsdd.service

# Install multimedia and creator tools
RUN dnf -y install \
    # Office and productivity
    libreoffice \
    # GIS
    qgis python3-qgis \
    # Web browsers
    firefox \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Install Prism Launcher (offline AppImage)
COPY offline-repo/prismlauncher/ /opt/prismlauncher/
RUN if [ -f /opt/prismlauncher/prism-launcher.AppImage ]; then \
        chmod +x /opt/prismlauncher/prism-launcher.AppImage && \
        ln -sf /opt/prismlauncher/prism-launcher.AppImage /usr/local/bin/prism-launcher && \
    printf '%s\n' \
"[Desktop Entry]" \
"Type=Application" \
"Name=Prism Launcher" \
"Comment=Minecraft launcher" \
"Exec=/usr/local/bin/prism-launcher" \
"Icon=application-x-executable" \
"Terminal=false" \
"Categories=Game;" \
> /usr/share/applications/prism-launcher.desktop && \
        echo "Prism Launcher installed and linked"; \
    else \
        echo "Note: Prism Launcher AppImage not found in offline repo"; \
    fi

# Install Google Chrome (from official repo, skip post-install scripts to avoid RPM lock issues)
RUN dnf -y install liberation-fonts && \
    curl -fsSL https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm -o /tmp/google-chrome.rpm && \
    rpm -i --noscripts /tmp/google-chrome.rpm && \
    rm -f /tmp/google-chrome.rpm && \
    dnf -y clean all && rm -rf /var/cache/dnf

# Install multiple Python versions with pip
RUN dnf -y install \
    python3.9 python3.10 python3.11 python3.12 python3.13 \
    # Python ML/data science from Fedora repos
    python3-numpy python3-scipy python3-pandas \
    python3-matplotlib python3-scikit-learn \
    python3-jupyter-core python3-notebook python3-ipython \
    python3-seaborn python3-opencv \
    hdf5 hdf5-devel openblas-devel \
    lapack lapack-devel \
    # Triton Inference Server client dependencies
    python3-protobuf python3-grpcio python3-requests \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Install Triton Client libraries via pip (for all Python versions)
RUN for py in python3.9 python3.10 python3.11 python3.12 python3.13; do \
    echo "Installing pip packages for $py..."; \
    $py -m ensurepip --upgrade || (curl -fsSL https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py && $py /tmp/get-pip.py && rm -f /tmp/get-pip.py); \
    $py -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
        $py -m pip install --no-cache-dir \
            tritonclient[all] \
            numpy scipy pandas \
            matplotlib scikit-learn \
            jupyter notebook ipython \
            seaborn opencv-python \
            || true; \
    done

# Install Node.js and JavaScript tools
RUN dnf -y install \
    nodejs npm yarn \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Install 3D graphics
RUN dnf -y install \
    blender \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Install database viewers/tools
RUN dnf -y install \
    sqlite sqlite-devel \
    sqlitebrowser \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Filesystem support
RUN dnf -y install \
    ntfs-3g ntfsprogs exfatprogs \
    e2fsprogs btrfs-progs xfsprogs f2fs-tools dosfstools \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Boot and bootloader packages
RUN dnf -y install \
    grub2-pc grub2-pc-modules \
    grub2-efi-x64 grub2-efi-x64-modules grub2-efi-x64-cdboot \
    grub2-efi-ia32 grub2-efi-ia32-cdboot \
    grub2-tools grub2-tools-efi \
    syslinux efibootmgr \
    shim-x64 shim-ia32 \
    dracut dracut-live \
    && dnf -y clean all && rm -rf /var/cache/dnf

# Create directories for third-party packages
RUN mkdir -p /tmp/rpms/{nvidia,vscode,rpmfusion,winehq,docker-desktop,drawio} && \
    mkdir -p /opt/prismlauncher

# Install OBS Studio and multimedia codecs (offline preferred, online fallback)
COPY offline-repo/obs/ /tmp/rpms/obs/
COPY offline-repo/rpmfusion/ /tmp/rpms/rpmfusion/
RUN if [ -n "$(ls -A /tmp/rpms/obs/*.rpm 2>/dev/null)" ]; then \
        echo "Installing OBS Studio and dependencies from offline repo..."; \
        dnf -y install --best --skip-broken /tmp/rpms/obs/*.rpm && \
        dnf -y clean all && rm -rf /var/cache/dnf && \
        echo "OBS Studio installed successfully from offline packages"; \
    elif [ -n "$(ls -A /tmp/rpms/rpmfusion/*.rpm 2>/dev/null)" ]; then \
        echo "Installing RPM Fusion packages from offline repo..."; \
        dnf -y install --best --skip-broken /tmp/rpms/rpmfusion/*.rpm && \
        dnf -y clean all && rm -rf /var/cache/dnf && \
        echo "RPM Fusion packages installed"; \
    else \
        echo "Offline OBS/RPM Fusion packages not found, attempting online install..."; \
        dnf -y install \
            https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
            https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm || true; \
        dnf -y install --best --skip-broken ffmpeg vlc obs-studio \
            gstreamer1-plugins-bad-free-extras gstreamer1-plugins-ugly \
            gstreamer1-plugin-openh264 gstreamer1-libav lame x264 x265 && \
        dnf -y clean all && rm -rf /var/cache/dnf || true; \
    fi

# Install NVIDIA drivers (offline preferred, online fallback)
COPY offline-repo/nvidia/ /tmp/rpms/nvidia/
RUN if [ -n "$(find /tmp/rpms/nvidia/ -maxdepth 1 -type f -name '*.rpm' 2>/dev/null)" ]; then \
        echo "Installing NVIDIA drivers from offline repo..."; \
        dnf -y install /tmp/rpms/nvidia/*.rpm || { \
            echo "Offline NVIDIA installation failed, falling back to online..."; \
            dnf -y install \
                https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm && \
            dnf -y install --best \
                akmod-nvidia \
                xorg-x11-drv-nvidia \
                xorg-x11-drv-nvidia-cuda \
                xorg-x11-drv-nvidia-cuda-libs \
                nvidia-settings \
                nvidia-persistenced; \
        }; \
    else \
        echo "Offline NVIDIA packages not found, installing from RPM Fusion..."; \
        dnf -y install \
            https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm && \
        dnf -y install --best \
            akmod-nvidia \
            xorg-x11-drv-nvidia \
            xorg-x11-drv-nvidia-cuda \
            xorg-x11-drv-nvidia-cuda-libs \
            nvidia-settings \
            nvidia-persistenced; \
    fi && \
    dnf -y clean all && rm -rf /var/cache/dnf /tmp/rpms/nvidia

# Install VS Code (offline preferred, online fallback)
COPY offline-repo/vscode/ /tmp/rpms/vscode/
RUN if [ -n "$(find /tmp/rpms/vscode/ -maxdepth 1 -type f -name '*.rpm' 2>/dev/null)" ]; then \
        echo "Installing VS Code from offline repo..."; \
        find /tmp/rpms/vscode/ -maxdepth 1 -type f -name 'code-*.rpm' -exec dnf -y install {} \; || true; \
    else \
        echo "Offline VS Code package not found, attempting online install..."; \
        rpm --import https://packages.microsoft.com/keys/microsoft.asc || true; \
        sh -c 'echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" > /etc/yum.repos.d/vscode.repo' || true; \
        dnf -y install code || true; \
    fi

# Install WineHQ and Lutris (offline preferred, online fallback)
COPY offline-repo/winehq/ /tmp/rpms/winehq/
RUN if [ -n "$(ls -A /tmp/rpms/winehq/*.rpm 2>/dev/null)" ]; then \
        echo "Installing WineHQ from offline repo..."; \
        dnf -y install /tmp/rpms/winehq/*.rpm || true; \
    else \
        echo "Offline WineHQ packages not found, attempting online install..."; \
        dnf -y install dnf-plugins-core || true; \
        dnf config-manager --add-repo https://dl.winehq.org/wine-builds/fedora/$(rpm -E %fedora)/winehq.repo || true; \
        dnf -y install winehq-stable || true; \
    fi

# Install Lutris gaming platform
RUN dnf -y install lutris || true

# Install Docker Desktop (offline preferred, online fallback)
COPY offline-repo/docker-desktop/ /tmp/rpms/docker-desktop/
RUN if [ -n "$(ls -A /tmp/rpms/docker-desktop/*.rpm 2>/dev/null)" ]; then \
        echo "Installing Docker Desktop from offline repo..."; \
        dnf -y install dnf-plugins-core || true; \
        (curl -fsSL https://download.docker.com/linux/fedora/docker-ce.repo -o /etc/yum.repos.d/docker-ce.repo && \
         dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || true) || true; \
        dnf -y install /tmp/rpms/docker-desktop/*.rpm || true; \
    else \
        echo "Offline Docker Desktop package not found, attempting online install..."; \
        dnf -y install dnf-plugins-core || true; \
        curl -fsSL https://download.docker.com/linux/fedora/docker-ce.repo -o /etc/yum.repos.d/docker-ce.repo || true; \
        dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || true; \
        curl -fsSL "https://desktop.docker.com/linux/main/amd64/docker-desktop-x86_64.rpm" -o /tmp/docker-desktop.rpm || true; \
        dnf -y install /tmp/docker-desktop.rpm || true; \
        rm -f /tmp/docker-desktop.rpm; \
    fi

# Install draw.io (offline preferred, online fallback)
COPY offline-repo/drawio/ /tmp/rpms/drawio/
RUN if [ -n "$(ls -A /tmp/rpms/drawio/*.rpm 2>/dev/null)" ]; then \
        echo "Installing draw.io from offline repo..."; \
        dnf -y install /tmp/rpms/drawio/*.rpm || true; \
    else \
        echo "Offline draw.io package not found, skipping (not in Fedora repos)..."; \
    fi

# Clean up RPM temp directory
RUN rm -rf /tmp/rpms


# Copy VS Code extensions
RUN mkdir -p /opt/vscode-extensions
COPY vscode-extensions/*.vsix /opt/vscode-extensions/
# Extensions will be installed per-user via scvu-post-install.sh

# Post-install scripts folder removed; using consolidated script only

# Include image README inside the system image (alongside helper scripts)
COPY SCVU-README.md /usr/local/bin/SCVU-README.md

# Remove ML installer script (not used); keep directory only

# Create JavaScript frameworks installer
RUN cat > /usr/local/bin/install-js-frameworks.sh <<'EOF'
#!/bin/bash
# Install JavaScript frameworks globally
set -e
echo "Installing JavaScript frameworks..."
npm install -g create-react-app @vue/cli @angular/cli create-next-app \
  vite webpack webpack-cli typescript ts-node \
  jest mocha eslint prettier pnpm || true
echo "JavaScript frameworks installed"
EOF
RUN chmod +x /usr/local/bin/install-js-frameworks.sh

# Create OpenShift/Kubernetes CLI installer
RUN cat > /usr/local/bin/install-openshift-tools.sh <<'EOF'
#!/bin/bash
# Install OpenShift and Kubernetes CLI tools
# These are not available in Fedora repos and require manual download
set -e

OC_VERSION="latest"  # or specify version like "4.14.0"
KUBECTL_VERSION="$(curl -L -s https://dl.k8s.io/release/stable.txt 2>/dev/null || echo 'v1.29.0')"
INSTALL_DIR="/usr/local/bin"

echo "======================================"
echo "OpenShift/Kubernetes CLI Installation"
echo "======================================"
echo ""

# Install oc (OpenShift CLI)
if ! command -v oc &> /dev/null; then
    echo "Installing oc (OpenShift CLI)..."
    cd /tmp
    if [ "$OC_VERSION" = "latest" ]; then
        OC_URL="https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz"
    else
        OC_URL="https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OC_VERSION}/openshift-client-linux.tar.gz"
    fi
    
    if curl -fL "$OC_URL" -o oc.tar.gz; then
        tar -xzf oc.tar.gz oc kubectl
        mv oc "$INSTALL_DIR/"
        [ -f kubectl ] && mv kubectl "$INSTALL_DIR/"
        chmod +x "$INSTALL_DIR/oc" "$INSTALL_DIR/kubectl" 2>/dev/null || true
        rm -f oc.tar.gz README.md
        echo "✓ oc installed: $(oc version --client 2>/dev/null | head -1)"
    else
        echo "✗ Failed to download oc. Check internet connection or try manual download from:"
        echo "  https://mirror.openshift.com/pub/openshift-v4/clients/ocp/"
    fi
else
    echo "✓ oc already installed: $(oc version --client 2>/dev/null | head -1)"
fi

# Install kubectl if not already present (oc bundle includes it)
if ! command -v kubectl &> /dev/null; then
    echo "Installing kubectl..."
    cd /tmp
    if curl -fLO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"; then
        chmod +x kubectl
        mv kubectl "$INSTALL_DIR/"
        echo "✓ kubectl installed: $(kubectl version --client 2>/dev/null | head -1)"
    else
        echo "✗ Failed to download kubectl. Check internet connection."
    fi
else
    echo "✓ kubectl already installed: $(kubectl version --client 2>/dev/null | head -1)"
fi

echo ""
echo "======================================"
echo "Installation Complete"
echo "======================================"
echo ""
echo "Verify installation:"
echo "  oc version --client"
echo "  kubectl version --client"
echo ""
echo "Connect to a cluster:"
echo "  oc login https://api.your-cluster.com:6443"
echo "  kubectl config use-context your-context"
echo ""
EOF
RUN chmod +x /usr/local/bin/install-openshift-tools.sh

# Install OpenShift/Kubernetes CLI tools from offline cache (if present)
COPY offline-repo/openshift/ /tmp/openshift/
RUN if [ -f /tmp/openshift/oc ]; then \
        echo "Installing oc from offline cache..."; \
        install -m 0755 /tmp/openshift/oc /usr/local/bin/oc; \
        echo "✓ oc installed from offline cache"; \
    fi && \
    if [ -f /tmp/openshift/kubectl ]; then \
        echo "Installing kubectl from offline cache..."; \
        install -m 0755 /tmp/openshift/kubectl /usr/local/bin/kubectl; \
        echo "✓ kubectl installed from offline cache"; \
    fi && \
    rm -rf /tmp/openshift

# Install CodeReady Containers (CRC) from offline cache (if present)
COPY offline-repo/crc/ /tmp/crc/
RUN if [ -f /tmp/crc/crc ]; then \
        echo "Installing CRC from offline cache..."; \
        install -m 0755 /tmp/crc/crc /usr/local/bin/crc; \
        echo "✓ CRC installed from offline cache: $(crc version 2>/dev/null | head -1 || echo 'version check skipped')"; \
    fi && \
    rm -rf /tmp/crc

# Copy Triton Server container image (if present) to user share location
# Users can load it with: podman load -i ~/.local/share/triton/tritonserver-*.tar
# COPY offline-repo/triton/ /tmp/triton/
# RUN if [ -n "$(ls -A /tmp/triton/*.tar 2>/dev/null)" ]; then \
#         echo "Copying Triton Server container image to shared location..."; \
#         mkdir -p /usr/share/triton; \
#         cp /tmp/triton/*.tar /usr/share/triton/; \
#         chmod 644 /usr/share/triton/*.tar; \
#         echo "✓ Triton Server image copied to /usr/share/triton/"; \
#         echo "  Load with: podman load -i /usr/share/triton/tritonserver-*.tar"; \
#     fi && \
#     rm -rf /tmp/triton

# Create consolidated post-install script
RUN cat > /usr/local/bin/scvu-post-install.sh <<'EOF'
#!/bin/bash
set -e

echo "SCVU Post-Install: starting"

# Check if running as root
if [[ $EUID -ne 0 ]]; then
    echo "Error: This script must be run as root (use: sudo scvu-post-install.sh)"
    exit 1
fi

install_extensions_for_user() {
    local U="$1"
    [ -n "$U" ] || return 0
    
    local HOME_DIR
    HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
    [ -d "$HOME_DIR" ] || { echo "Home not found for $U"; return 0; }
    
    if ! command -v code >/dev/null 2>&1; then
        echo "VS Code not found; skipping for $U"
        return 0
    fi
    
    echo "Installing VS Code extensions for user $U..."
    mkdir -p "$HOME_DIR/.vscode/extensions"
    chown -R "$U":"$U" "$HOME_DIR/.vscode"
    
    for VSIX in /opt/vscode-extensions/*.vsix; do
        [ -f "$VSIX" ] || continue
        echo "  Installing $(basename "$VSIX")"
        sudo -u "$U" code --install-extension "$VSIX" --force 2>/dev/null || echo "  Warning: extension install failed, continuing"
    done
}

# 1) Install VS Code extensions for specified users (args) or all local users
echo "Step 1: Installing VS Code extensions..."
if [ "$#" -gt 0 ]; then
    echo "  For specified users: $*"
    for U in "$@"; do 
        install_extensions_for_user "$U"
    done
else
    echo "  For all local users..."
    mapfile -t USERS < <(getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
    echo "  Found ${#USERS[@]} users: ${USERS[*]}"
    for U in "${USERS[@]}"; do 
        install_extensions_for_user "$U"
    done
fi

# 2) Place README on each user's Desktop
echo "Step 2: Copying README to user desktops..."
if [ -f /usr/local/bin/SCVU-README.md ]; then
    mapfile -t USERS < <(getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ && $6 ~ /^\// {print $1}')
    echo "  Found ${#USERS[@]} users: ${USERS[*]}"
    for U in "${USERS[@]}"; do
        HOME_DIR=$(getent passwd "$U" | awk -F: '{print $6}')
        [ -d "$HOME_DIR" ] || continue
        mkdir -p "$HOME_DIR/Desktop"
        cp /usr/local/bin/SCVU-README.md "$HOME_DIR/Desktop/SCVU-README.md"
        chown "$U":"$U" "$HOME_DIR/Desktop/SCVU-README.md"
        echo "  Copied to $U Desktop"
    done
else
    echo "  README not found, skipping"
fi

# 3) Enable services
echo "Step 3: Enabling GUI services..."
systemctl enable sddm 2>/dev/null || echo "  Warning: SDDM enable failed"
systemctl enable xrdp 2>/dev/null || echo "  Warning: XRDP enable failed"
systemctl set-default graphical.target 2>/dev/null || echo "  Warning: graphical.target set failed"

# 4) NVIDIA driver post steps
echo "Step 4: NVIDIA post-install..."
if command -v nvidia-smi >/dev/null 2>&1; then
    echo "  NVIDIA detected; updating initramfs..."
    if command -v dracut >/dev/null 2>&1; then
        dracut -f 2>/dev/null || echo "  Warning: dracut update failed"
    else
        echo "  Warning: dracut not available, skipping initramfs update"
    fi
else
    echo "  NVIDIA not detected, skipping"
fi

# 5) Docker group setup
echo "Step 5: Docker group setup..."
if getent group docker >/dev/null 2>&1; then
    if [ -n "$SUDO_USER" ]; then
        usermod -aG docker "$SUDO_USER" 2>/dev/null || true
        echo "  Added $SUDO_USER to docker group"
    fi
else
    echo "  Docker group not found, skipping"
fi

# 6) Podman socket activation
echo "Step 6: Podman setup..."
systemctl --user enable podman.socket 2>/dev/null || echo "  Note: Podman user socket setup requires per-user execution"

echo ""
echo "SCVU Post-Install: complete"
echo "Note: Some services may require a reboot to take full effect"
EOF
RUN chmod +x /usr/local/bin/scvu-post-install.sh

# Create docker group and default user
RUN groupadd -f docker && \
    useradd -m -G wheel,docker -s /bin/bash IAC 2>/dev/null || true

# Set passwords
RUN echo 'root:T@bleTennis0!04' | chpasswd && \
    echo 'IAC:T@bleTennis0!04' | chpasswd

# Enable services
RUN systemctl enable sddm || true && \
    systemctl enable xrdp || true && \
    systemctl set-default graphical.target || true

# Create README in users' home
RUN cat > /etc/skel/README.txt <<'EOF'
Welcome to SCVU Bootc Workstation
==================================

Users:
- IAC (admin, sudo access)

Post-install tasks:
1. Run consolidated post install: sudo /usr/local/bin/scvu-post-install.sh
2. Install JS frameworks: /usr/local/bin/install-js-frameworks.sh

All users are in the docker group for Docker Desktop.
EOF

# Bootc configuration
RUN echo 'SCVU Bootc' > /etc/hostname && \
    (grep -q "\bSCVU Bootc\b" /etc/hosts || echo "127.0.1.1    SCVU Bootc" >> /etc/hosts)

# Final cleanup
RUN dnf -y clean all && rm -rf /var/cache/dnf /tmp/* /var/tmp/*
